  "career_response_example": {
    "status": "proposal_not_application",
    "options": [
      {
        "role": "業務自動化の小規模支援",
        "fit": [
          "Python",
          "業務整理"
        ],
        "unknowns": [
          "本人の実績",
          "希望する働き方"
        ],
        "next_step": "過去に改善した作業を1件だけ匿名で整理する"
      }
    ],
    "market_claims_verified": false
  },
  "negative_semantic_cases": [
    {
      "input_condition": "External model route receives any private source or balance",
      "expected": "EGRESS_DENIED before prompt/tool-result transmission"
    },
    {
      "input_condition": "Agent requests deadline verification/completion or inventory live append",
      "expected": "CAPABILITY_DISABLED; tool absent"
    },
    {
      "input_condition": "Draft source says no date, agent invents expiry from cycle",
      "expected": "EVIDENCE_MISMATCH; no draft materialization"
    },
    {
      "input_condition": "Inventory purchase/consumption quantity is zero",
      "expected": "SCHEMA_INVALID at semantic validation"
    },
    {
      "input_condition": "Different owner supplies valid-looking source/draft/profile UUID",
      "expected": "SOURCE_NOT_FOUND/OWNER_SCOPE_DENIED without revealing existence"
    },
    {
      "input_condition": "Receipt duplicates a confirmed imported transaction",
      "expected": "Candidate remains unresolved; no second expense added"
    },
    {
      "input_condition": "Candidate changes after reminder approval or task is complete",
      "expected": "STALE_SNAPSHOT; suppress delivery until reviewed"
    },
    {
      "input_condition": "Tool response lost after append",
      "expected": "Same idempotency key/input replays same result; do not create another draft"
    }
  ]
}
