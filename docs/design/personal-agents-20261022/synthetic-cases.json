          "00000000-0000-4000-8000-000000000001"
        ],
        "needs_review": []
      }
    },
    {
      "name": "確認済み期限への私的通知候補。まだ予定を作らない",
      "tool": "private.reminder.propose",
      "input": {
        "candidate_entry_id": "00000000-0000-4000-8000-000000000002",
        "confirmed_digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "remind_at": "2027-03-01T09:00:00+09:00",
        "time_zone": "Asia/Tokyo",
        "idempotency_key": "fixture-reminder-1"
