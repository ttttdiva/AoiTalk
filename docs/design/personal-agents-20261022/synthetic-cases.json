{
  "synthetic_only": true,
  "cases": [
    {
      "name": "期限を明記された値のまま候補化。法定期限の主張ではない",
      "tool": "private.draft.propose",
      "input": {
        "evidence_ref": "00000000-0000-4000-8000-000000000001",
        "proposal": {
          "kind": "deadline",
          "data": {
            "subject_key": "document_a",
            "due_date": "2027-03-15",
            "label": "架空書類の確認待ち日付"
          }
        },
        "idempotency_key": "fixture-deadline-1"
      },
      "expected_success": {
        "draft_ref": "00000000-0000-4000-8000-000000000002",
        "confirmed_digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "status": "awaiting_user_review",
        "effective_ledger_change": false
      }
    },
    {
      "name": "過去の消費の記帳候補。残数は未変更",
      "tool": "private.draft.propose",
      "input": {
        "evidence_ref": "00000000-0000-4000-8000-000000000001",
        "proposal": {
          "kind": "inventory",
          "data": {
            "subject_key": "item_a",
            "entry_type": "consumption",
            "quantity": 2,
            "unit": "pcs",
            "occurred_on": "2026-10-20"
          }
        },
        "idempotency_key": "fixture-inventory-1"
      },
      "expected_success": {
        "draft_ref": "00000000-0000-4000-8000-000000000002",
        "confirmed_digest": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "status": "awaiting_user_review",
        "effective_ledger_change": false
      }
    },
    {
      "name": "合成レシート1件。金額は通貨の最小単位",
      "tool": "private.draft.propose",
      "input": {
        "evidence_ref": "00000000-0000-4000-8000-000000000001",
        "proposal": {
          "kind": "finance",
          "data": {
            "source_format": "receipt_image",
            "rows": [
              {
                "row_ref": "00000000-0000-4000-8000-000000000003",
                "occurred_on": "2026-10-20",
                "kind": "expense",
                "amount_minor": 1280,
                "currency": "JPY",
                "account_alias": "wallet_a",
                "category": "食費"
              }
            ]
          }
        },
        "idempotency_key": "fixture-finance-1"
      },
      "expected_success": {
        "draft_ref": "00000000-0000-4000-8000-000000000002",
        "confirmed_digest": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "status": "awaiting_user_review",
        "effective_ledger_change": false
      }
    },
    {
      "name": "合成キャリア情報。求人検索や応募ではない",
      "tool": "private.career.context",
      "input": {
        "accepted_profile_ref": "00000000-0000-4000-8000-000000000002"
      },
      "expected_success": {
        "profile": {
          "skills": [
            "Python",
