    {
      "name": "private.ledger.state",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ledger": {
            "type": "string",
            "enum": [
              "deadline",
              "inventory"
            ]
          },
          "subject_key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          }
        },
        "required": [
          "ledger"
        ],
        "$defs": {}
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "snapshot_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "deadlines": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/DeadlineState"
            }
          },
          "inventory": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/InventoryState"
            }
          }
        },
        "required": [
          "snapshot_digest",
          "deadlines",
          "inventory"
        ],
        "$defs": {
          "DeadlineState": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subject_key": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "candidate_entry_id": {
                "type": "string",
                "format": "uuid"
              },
              "due_date": {
                "type": "string",
                "format": "date"
              },
              "status": {
                "type": "string",
                "enum": [
                  "unverified",
                  "verified"
                ]
              },
              "candidate_origin": {
                "type": "string",
                "enum": [
                  "agent_observation",
                  "user_entered"
                ]
              },
              "completed_on": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "confirm_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "needs_review": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "subject_key",
              "candidate_entry_id",
              "due_date",
              "status",
              "candidate_origin",
              "completed_on",
              "confirm_digest",
              "needs_review"
            ]
          },
          "InventoryState": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subject_key": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "balances": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "unit": {
                      "type": "string"
                    },
                    "balance": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "unit",
                    "balance"
                  ]
                }
              },
              "needs_review": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "subject_key",
              "balances",
              "needs_review"
            ]
          }
        }
      },
      "server_enforcement": [
        "Use agent_actor_from_turn_context and PersonalLedgerService.list_entries with ledger/subject SQL filters before decryption, then derive_state; never call the interactive-owner HTTP route as an agent.",
        "Filter authorized ledger/subject before returning. Preserve needs_review and origin. No user_id or permit/serial numbers in output.",
        "5000-row existing service limit is a hard error, not partial success; retain this until an exact paged projection exists.",
        "Return private payload only into an approved local execution context. UI privacy and encrypted DB alone do not authorize external model transport."
      ]
    },
