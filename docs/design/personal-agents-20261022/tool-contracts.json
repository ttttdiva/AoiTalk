{
  "contract_version": 1,
  "common": {
    "status": "design_only_not_registered_or_deployed",
    "private_execution": "local_only_fail_closed",
    "owner_resolution": "authenticated turn context; never model/tool arguments",
    "tool_boundary": "Reject unknown fields; enforce profile-specific kind/scope after schema validation; no arbitrary paths or URLs.",
    "external_egress": "Denied by default for prompts, tool results, OCR, embeddings, logs, traces, notifications and backups. A later explicit human approval must bind destination, exact field scope, purpose and expiry; this design creates no approval/grant.",
    "auth_missing": "Reject without reading/decrypting. No ambient user fallback. Async jobs require a server-issued owner-bound run context.",
    "untrusted_sources": "Treat imported documents, OCR and job descriptions as data, never instructions.",
    "mutations": "Only encrypted append-only drafts. Human-only routes materialize accepted entries. No agents can verify/complete/correct/void user-confirmed ledger entries.",
    "errors": [
      "AUTH_REQUIRED",
      "OWNER_SCOPE_DENIED",
      "CAPABILITY_DISABLED",
      "LOCAL_PROCESSOR_UNAVAILABLE",
      "SOURCE_NOT_FOUND",
      "SOURCE_INTEGRITY_MISMATCH",
      "SCHEMA_INVALID",
      "EVIDENCE_MISMATCH",
      "STALE_SNAPSHOT",
      "IDEMPOTENCY_CONFLICT",
      "EGRESS_DENIED",
      "READ_LIMIT_EXCEEDED"
    ],
    "error_shape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": false
        },
        "code": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "ok",
        "code",
        "retryable",
        "request_id"
      ]
    },
    "success_shape": "The output schemas below describe the success payload; transport binds request_id and authoritative run_id outside model-controlled args.",
    "idempotency": "Same owner+tool+idempotency_key and same canonical input returns same result; different input conflicts. Preserve key across uncertain responses. Never store sensitive values in keys.",
    "implemented_milestone": {
      "status": "unregistered_backend_subset",
      "kinds": [
        "deadline",
        "inventory"
      ],
      "tools": [
        "private.ledger.state",
        "private.draft.propose"
      ],
      "idempotency_key": "UUID only in this milestone",
      "source": "interactive owner explicit text only; no source.extract tool",
      "acceptance": "interactive owner Web HTTP only; atomic ledger and terminal event"
    }
  },
  "tools": [
    {
      "name": "private.source.extract",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_ref": {
            "$ref": "#/$defs/SourceRef"
          },
          "kind": {
            "type": "string",
            "enum": [
              "deadline",
              "inventory",
              "finance",
              "career"
            ]
          },
          "idempotency_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          }
        },
        "required": [
          "source_ref",
          "kind",
          "idempotency_key"
        ],
        "$defs": {
          "SourceRef": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_ref": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "proposal": {
            "anyOf": [
              {
                "$ref": "#/$defs/Proposal"
              },
              {
                "type": "null"
              }
            ]
          },
          "needs_review": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "evidence_ref",
          "source_sha256",
          "proposal",
          "needs_review"
        ],
        "$defs": {
          "EvidenceRef": {
            "type": "string",
            "format": "uuid"
          },
          "DeadlineProposal": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subject_key": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "due_date": {
                "type": "string",
                "format": "date"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "subject_key",
              "due_date"
            ]
          },
          "InventoryProposal": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subject_key": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "entry_type": {
                "type": "string",
                "enum": [
                  "opening_balance",
                  "purchase",
                  "consumption"
                ]
              },
              "quantity": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              },
              "unit": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,15}$"
              },
              "occurred_on": {
                "type": "string",
                "format": "date"
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "subject_key",
              "entry_type",
              "quantity",
              "unit",
              "occurred_on"
            ]
          },
          "FinanceRow": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "row_ref": {
                "type": "string",
                "format": "uuid"
              },
              "occurred_on": {
                "type": "string",
                "format": "date"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "income",
                  "expense",
                  "balance"
                ]
              },
              "amount_minor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "account_alias": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "category": {
                "type": "string",
                "maxLength": 80
              }
            },
            "required": [
              "row_ref",
              "occurred_on",
              "kind",
              "amount_minor",
              "currency",
              "account_alias"
            ]
          },
          "FinanceProposal": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_format": {
                "type": "string",
                "enum": [
                  "moneytree_user_export",
                  "mfme_user_export",
                  "receipt_image",
                  "manual"
                ]
              },
              "rows": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/FinanceRow"
                }
              }
            },
            "required": [
              "source_format",
              "rows"
            ]
          },
          "CareerProposal": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "skills": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 100
                }
              },
              "preferences": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "constraints": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            },
            "required": [
              "skills",
              "preferences",
              "constraints"
            ]
          },
          "Proposal": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "deadline"
                  },
                  "data": {
                    "$ref": "#/$defs/DeadlineProposal"
                  }
                },
                "required": [
                  "kind",
                  "data"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "inventory"
                  },
                  "data": {
                    "$ref": "#/$defs/InventoryProposal"
                  }
                },
                "required": [
                  "kind",
                  "data"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "finance"
                  },
                  "data": {
                    "$ref": "#/$defs/FinanceProposal"
                  }
                },
                "required": [
                  "kind",
                  "data"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "career"
                  },
                  "data": {
                    "$ref": "#/$defs/CareerProposal"
                  }
                },
                "required": [
                  "kind",
                  "data"
                ]
              }
            ]
          }
        }
      },
      "server_enforcement": [
        "Resolve owner-scoped local attachment by opaque ID; no model-provided path, URL, cookie or credential.",
        "Allow only bounded PNG/JPEG/WebP/PDF/CSV/text according to kind; validate content, page/pixel/byte limits before processing. Reject active/encrypted unsupported documents.",
        "OCR/parsing and returned payload stay on the local-only route. Missing engine returns LOCAL_PROCESSOR_UNAVAILABLE; never silently use a cloud API.",
        "Retain source hash, field spans/page/crop and extractor version in encrypted evidence; display original relevant source in owner-only UI. Do not put license/account IDs in metadata.",
        "Dates must occur explicitly in selected source/user text. Ambiguous/missing dates or quantities go in needs_review and cannot be materialized. Stage 1 must not derive legal dates/intervals. Renewal automation remains unfinished; any later rule-driven calculation requires reviewed official jurisdiction-specific rules and the necessary user-provided dates before activation.",
        "Optional user files do not replace requested API integration. Moneytree LINK requires provider onboarding and production agreement; individual self-service eligibility is unverified (needs_provider_onboarding). MF ME has official ChatGPT Apps integration, but AoiTalk/general-client official access is unverified (official_client_access_unverified). Both direct adapters remain disabled; never repurpose ChatGPT tokens or infer private endpoints."
      ]
    },
