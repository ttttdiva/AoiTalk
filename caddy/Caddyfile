{
	# HTTP入口のredirectは下の明示routeで管理し、TLS証明書の自動管理だけを維持する。
	auto_https disable_redirects

	# 公開経路はTCPだけで到達できる構成とし、QUIC/HTTP/3へ再誘導しない。
	servers {
		protocols h1 h2
	}

	log {
		output file "{$AOITALK_CADDY_RUNTIME_LOG:logs/web/caddy-runtime.log}" {
			roll_size 5MiB
			roll_keep 5
			{$AOITALK_CADDY_LOG_ROLL_EXTRA}
		}
		format console
	}
}

# AoiTalk リバースプロキシ
#
# ComposeではAOITALK_CADDY_PORTのHTTPS（Caddyの内部CA／自動証明書）。会社運用では、
# AOITALK_CADDY_SITE_ADDRESS に会社DNS名を設定し、公開CAまたは会社CAの証明書運用を選ぶ。
# FastAPI/Next.jsの上流は環境変数で切り替え、Windows固有の絶対パスを持たない。

# WSL/Docker Desktopのloopback転送ではIP直指定のTLS SNIが不安定なため、
# 初回の http://127.0.0.1 は、証明書対象のサイト名へ明示的に寄せる。
http://127.0.0.1 {
	handle /healthz {
		rewrite * /login
		reverse_proxy {$AOITALK_CADDY_NEXT_UPSTREAM:127.0.0.1:3002}
	}
	handle {
		redir https://{$AOITALK_CADDY_SITE_ADDRESS:localhost}:{$AOITALK_CADDY_PORT:6002}{uri} 308
	}
}

{$AOITALK_CADDY_SITE_LABEL:localhost:6002} {
	# Windows personalではservice_managerがHTTPS catch-allとIPv4 bindを渡す。
	# Linux nativeでは名前付きsite labelを渡し、従来の自動HTTPSを維持する。
	{$AOITALK_CADDY_BIND_DIRECTIVE:}

	# Windowsのrun.bat起動ではservice_managerが既存の公開証明書を指定する。
	# Linux/Composeでは未設定のまま展開され、従来どおりCaddyの自動HTTPSを使う。
	{$AOITALK_CADDY_TLS_DIRECTIVE:}

	# HTTP/3を広告していた期間に既存クライアントが保持したAlt-Svcを破棄させる。
	# TCP-onlyの公開経路では、h1/h2へ戻した後も明示的なclearが必要になる。
	header Alt-Svc "clear"

	log {
		output file "{$AOITALK_CADDY_ACCESS_LOG:logs/web/caddy-access.log}" {
			roll_size 10MiB
			roll_keep 5
			{$AOITALK_CADDY_LOG_ROLL_EXTRA}
		}
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>Set-Cookie delete
				request>headers>Proxy-Authorization delete
			}
		}
	}

	encode zstd gzip

	@hydrus_client_api {
		path /api_version /session_key /get_services /get_files/* /add_tags/* /edit_ratings/* /add_files/*
	}
	handle @hydrus_client_api {
		reverse_proxy {$AOITALK_CADDY_FASTAPI_UPSTREAM:127.0.0.1:3000}
	}

	# FastAPI専用エンドポイント（モバイル／OAuth／ファイル／Agent Harness）
	handle /api/auth/login/mobile {
		reverse_proxy {$AOITALK_CADDY_FASTAPI_UPSTREAM:127.0.0.1:3000}
	}
	handle /api/auth/refresh {
		reverse_proxy {$AOITALK_CADDY_FASTAPI_UPSTREAM:127.0.0.1:3000}
	}
	# logoutはcookie種別に関係なくFastAPIへ集約する。旧FastAPI cookieと
	# Next.js cookieが同名のため、cookie matcherで振り分けると主体を
	# 判別できず、古いセッションの全失効を取りこぼす。
	handle /api/auth/logout {
		reverse_proxy {$AOITALK_CADDY_FASTAPI_UPSTREAM:127.0.0.1:3000}
	}
	handle /api/filer/* {
		reverse_proxy {$AOITALK_CADDY_FASTAPI_UPSTREAM:127.0.0.1:3000}
	}
	handle /api/google-calendar/oauth/callback {
		reverse_proxy {$AOITALK_CADDY_FASTAPI_UPSTREAM:127.0.0.1:3000}
	}
	handle /api/webex/oauth/callback {
		reverse_proxy {$AOITALK_CADDY_FASTAPI_UPSTREAM:127.0.0.1:3000}
	}
	handle /api/agent-harness/* {
		reverse_proxy {$AOITALK_CADDY_FASTAPI_UPSTREAM:127.0.0.1:3000}
	}

	# These public Next.js auth/bootstrap routes must remain reachable without
	# Authorization.  They also stay on the BFF when a client sends an empty
	# header, instead of falling through to the FastAPI direct boundary.
	handle /api/auth/login {
		reverse_proxy {$AOITALK_CADDY_NEXT_UPSTREAM:127.0.0.1:3002}
	}
	handle /api/auth/login-form {
		reverse_proxy {$AOITALK_CADDY_NEXT_UPSTREAM:127.0.0.1:3002}
	}
	handle /api/auth/reset-password {
		reverse_proxy {$AOITALK_CADDY_NEXT_UPSTREAM:127.0.0.1:3002}
	}
	handle /api/auth/status {
		reverse_proxy {$AOITALK_CADDY_NEXT_UPSTREAM:127.0.0.1:3002}
	}

	# Unified Voice Session HTTP and WebSocket endpoints are authoritative in
	# FastAPI, including cookie-authenticated browser requests without an
	# Authorization header.  reverse_proxy preserves WebSocket upgrades.
	handle /api/voice-sessions* {
		reverse_proxy {$AOITALK_CADDY_FASTAPI_UPSTREAM:127.0.0.1:3000}
	}

	# Only a non-empty Authorization header selects the FastAPI direct
	# boundary.  Missing/empty Authorization remains on the Next.js BFF, whose
	# cookie session is the browser authentication path.
	@fastapi_authorized_api {
		path /api/*
		header_regexp Authorization ".+"
	}
	handle @fastapi_authorized_api {
		reverse_proxy {$AOITALK_CADDY_FASTAPI_UPSTREAM:127.0.0.1:3000}
	}

	handle /ws* {
		reverse_proxy {$AOITALK_CADDY_FASTAPI_UPSTREAM:127.0.0.1:3000}
	}

	# ブラウザ用のNext.js BFF/API
	handle /api/* {
		reverse_proxy {$AOITALK_CADDY_NEXT_UPSTREAM:127.0.0.1:3002}
	}
	handle {
		reverse_proxy {$AOITALK_CADDY_NEXT_UPSTREAM:127.0.0.1:3002}
	}
}
