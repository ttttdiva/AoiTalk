{
  "manifest_version": 3,
  "name": "AoiTalk Browser",
  "version": "1.0.0",
  "description": "AoiTalkから普段のMicrosoft Edgeのタブを操作します。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AoiTalk Browser",
    "default_popup": "popup.html"
  }
}
