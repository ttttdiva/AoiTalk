+// AoiTalk Portable Bridge custom modification, 2026-10-10. Based on vercel-labs/agent-browser; see NOTICE-bridge-modifications.txt.
+//! Direct daemon-contract integration with a local synthetic CDP transport.
+//! No real browser, profile, page contents or external network is involved.
+use super::*;
+use crate::test_utils::EnvGuard;
+use futures_util::{SinkExt, StreamExt};
+use std::sync::{Arc, Mutex};
+use tokio_tungstenite::tungstenite::Message;
+
+struct SyntheticBrowser {
+    url: String,
+    methods: Arc<Mutex<Vec<String>>>,
+    requests: Arc<Mutex<Vec<Value>>>,
+    targets: Arc<Mutex<Vec<String>>>,
+    scenario: Arc<Mutex<String>>,
+    connections: Arc<std::sync::atomic::AtomicUsize>,
+    server: tokio::task::JoinHandle<()>,
+}
+
+impl Drop for SyntheticBrowser {
+    fn drop(&mut self) {
+        self.server.abort();
+    }
+}
+
+impl SyntheticBrowser {
+    async fn start(fail_binding_on_create: Option<std::path::PathBuf>) -> Self {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let url = format!(
+            "ws://{}/devtools/browser/bridge-test",
+            listener.local_addr().unwrap()
+        );
+        let targets = Arc::new(Mutex::new(vec!["A".to_string()]));
+        let methods = Arc::new(Mutex::new(Vec::new()));
+        let recorded = methods.clone();
+        let requests = Arc::new(Mutex::new(Vec::new()));
+        let recorded_requests = requests.clone();
+        let scenario = Arc::new(Mutex::new(String::new()));
+        let server_scenario = scenario.clone();
+        let connection_count = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        let server_count = connection_count.clone();
+        let controlled_targets = targets.clone();
+        let server = tokio::spawn(async move {
+            let mut connections = tokio::task::JoinSet::new();
+            loop {
+                tokio::select! {
+                    accepted = listener.accept() => {
+                        let (stream, _) = accepted.unwrap();
+                        server_count.fetch_add(1,std::sync::atomic::Ordering::SeqCst);
+                        let targets = targets.clone();
+                        let methods = recorded.clone();
+                        let requests = recorded_requests.clone();
+                        let fail_path = fail_binding_on_create.clone();
+                        let scenario = server_scenario.clone();
+                        connections.spawn(async move {
+                            let mut ws = tokio_tungstenite::accept_async(stream).await.unwrap();
+                            while let Some(Ok(Message::Text(text))) = ws.next().await {
+                                let request: Value = serde_json::from_str(&text).unwrap();
+                                let method = request["method"].as_str().unwrap().to_string();
+                                methods.lock().unwrap().push(method.clone());
+                                requests.lock().unwrap().push(request.clone());
+                                let result = match method.as_str() {
+                                    "Browser.getVersion" => json!({"product":"Chrome/154.0.0.0","protocolVersion":"1.3"}),
+                                    "Target.getTargets" => json!({"targetInfos": targets.lock().unwrap().iter().map(|id| json!({"targetId":id,"type":match id.as_str() {"WEBVIEW" => "webview", "WORKER" => "service_worker", _ => "page"},"title":if *scenario.lock().unwrap() == "local-labels" { format!("PRIVATE_LOCAL_TITLE\n\t\u{0}\u{202e}\u{061c}{}", "\u{1f600}".repeat(700)) } else { "Synthetic".into() },"url":"https://example.invalid/fixture","attached":false})).collect::<Vec<_>>()}),
+                                    "Target.attachToTarget" => json!({"sessionId":format!("session-{}",request["params"]["targetId"].as_str().unwrap())}),
+                                    "Target.createTarget" => {
+                                        targets.lock().unwrap().push("B".into());
+                                        if let Some(path) = &fail_path {
+                                            std::fs::remove_file(path).unwrap();
+                                            std::fs::create_dir(path).unwrap();
+                                        }
+                                        json!({"targetId":"B"})
+                                    }
+                                    "Page.createIsolatedWorld" => json!({"executionContextId":7}),
+                                    "Runtime.evaluate" if request["params"]["expression"] == "document" => json!({"result":{"type":"object","objectId":"document"}}),
+                                    "Runtime.evaluate" => json!({"result":{"type":"number","value":1}}),
+                                    "DOM.resolveNode" => json!({"object":{"type":"object","subtype":"node","objectId":"node"}}),
+                                    "DOM.getBoxModel" => json!({"model":{"content":[0,0,10,0,10,10,0,10],"padding":[],"border":[],"margin":[],"width":10,"height":10}}),
+                                    "Input.dispatchMouseEvent" => {
+                                        if request["params"]["type"] == "mouseReleased" && *scenario.lock().unwrap() == "checkbox-after-click" {
+                                            methods.lock().unwrap().push("ClickReleased".into());
+                                            *scenario.lock().unwrap()="stale".into();
+                                        }
+                                        json!({})
+                                    },
+                                    "DOM.describeNode" if request["params"].get("objectId").is_some() => json!({"node":{"nodeName":"#document","backendNodeId":1}}),
+                                    "DOM.describeNode" => json!({"node":{"nodeName":"INPUT","backendNodeId":42,"attributes":["type","text"]}}),
+                                    "Accessibility.getFullAXTree" => json!({"nodes":[{"backendDOMNodeId":if *scenario.lock().unwrap() == "stale" {99} else {42},"role":{"value":"textbox"},"name":{"value":"Name"}}]}),
+                                    "Runtime.callFunctionOn" => {
+                                        let function = request["params"]["functionDeclaration"].as_str().unwrap_or("");
+                                        if function.contains("strictRefDestinations") { json!({"result":{"type":"object","value":{"href":null,"target":null,"form":null}}}) }
+                                        else if function.contains("strictRefFocus") { json!({"result":{"type":"boolean","value":true}}) }
+                                        else if function.contains("ariaCheckedRoles") { json!({"result":{"type":"boolean","value":false}}) }
+                                        else if function.contains("bridgeVerify") {
+                                            if *scenario.lock().unwrap() == "exception" { json!({"exceptionDetails":{"text":"PRIVATE_ACTUAL"},"result":{"type":"string","value":"PRIVATE_ACTUAL"}}) }
+                                            else { json!({"result":{"type":"boolean","value":*scenario.lock().unwrap() != "mismatch"}}) }
+                                        }
+                                        else if function == "function() { this.focus(); }" {
+                                            if *scenario.lock().unwrap() == "late-stale" { *scenario.lock().unwrap() = "stale".into(); }
+                                            json!({"result":{"type":"undefined"}})
+                                        }
+                                        else if function.contains("ownerDocument") { json!({"result":{"type":"object","objectId":"document"}}) }
+                                        else { json!({"result":{"type":"undefined"}}) }
+                                    },
+                                    "Page.getFrameTree" => json!({"frameTree":{"frame":{"id":"main","loaderId":"loader","url":"https://example.invalid/fixture"}}}),
+                                    _ => json!({}),
+                                };
+                                let response = if *scenario.lock().unwrap() == "deny-metadata" && method == "Target.getTargets" {
+                                    json!({"id":request["id"],"error":{"code":-32000,"message":"PRIVATE_PERMISSION_PENDING"}})
+                                } else if *scenario.lock().unwrap() == "deny-attach" && method == "Target.attachToTarget" {
+                                    json!({"id":request["id"],"error":{"code":-32000,"message":"PRIVATE_PERMISSION_PENDING"}})
+                                } else if *scenario.lock().unwrap() == "protocol-error" && request["params"]["functionDeclaration"].as_str().is_some_and(|f| f.contains("bridgeVerify")) {
+                                    json!({"id":request["id"],"error":{"code":-32000,"message":"PRIVATE_ACTUAL"}})
+                                } else { json!({"id":request["id"],"result":result}) };
+                                if ws.send(Message::Text(response.to_string())).await.is_err() { break; }
+                            }
+                        });
+                    }
+                    _ = connections.join_next(), if !connections.is_empty() => {}
+                }
+            }
+        });
+        Self {
+            url,
+            methods,
+            requests,
+            targets: controlled_targets,
+            scenario,
+            connections: connection_count,
+            server,
+        }
+    }
+}
+
+fn isolated_env() -> (EnvGuard<'static>, tempfile::TempDir) {
+    let env = EnvGuard::new(&[
+        "AGENT_BROWSER_SOCKET_DIR",
+        "AGENT_BROWSER_NAMESPACE",
+        "XDG_RUNTIME_DIR",
+        "AGENT_BROWSER_SESSION",
+        "AGENT_BROWSER_STRICT_REFS",
+        "AGENT_BROWSER_DEBUG",
+        "AGENT_BROWSER_CDP",
+        "AGENT_BROWSER_ATTACH_TARGET",
+    ]);
+    std::fs::create_dir_all("../.local").unwrap();
+    let dir = tempfile::Builder::new()
+        .prefix("bridge-contract-")
+        .tempdir_in("../.local")
+        .unwrap();
+    env.set("AGENT_BROWSER_SOCKET_DIR", dir.path().to_str().unwrap());
+    env.set("AGENT_BROWSER_SESSION", "bridge-contract");
+    env.set("AGENT_BROWSER_STRICT_REFS", "1");
+    (env, dir)
+}
