+async fn validated_strict_target(
+    client: &CdpClient,
+    page_session: &str,
+    ref_map: &RefMap,
+    selector_or_ref: &str,
+    iframe_sessions: &HashMap<String, String>,
+) -> Result<(StrictDocumentIdentity, i64), String> {
+    let result = async {
+        let ref_id = parse_ref(selector_or_ref).ok_or(STALE_REF)?;
+        let entry = ref_map.get(&ref_id).ok_or(STALE_REF)?;
+        let expected = entry.strict_identity.as_ref().ok_or(STALE_REF)?;
+        let backend_id = entry.backend_node_id.ok_or(STALE_REF)?;
+        let (params, session) =
+            resolve_ax_session(entry.frame_id.as_deref(), page_session, iframe_sessions);
+        if expected.document.page_session != page_session || expected.document.session != session {
+            return Err(STALE_REF.into());
+        }
+        let tree = client
+            .send_command_no_params("Page.getFrameTree", Some(session))
+            .await?;
+        let current = capture_strict_document(
+            client,
+            page_session,
+            session,
+            Some(&expected.document.frame),
+            &tree,
+        )
+        .await?;
+        if current != expected.document {
+            return Err(STALE_REF.into());
+        }
+        let ax = client
+            .send_command("Accessibility.getFullAXTree", Some(params), Some(session))
+            .await?;
+        let node = ax["nodes"]
+            .as_array()
+            .and_then(|nodes| {
+                nodes
+                    .iter()
+                    .find(|node| node["backendDOMNodeId"].as_i64() == Some(backend_id))
+            })
+            .ok_or(STALE_REF)?;
+        if exact_node_meaning(client, &current, backend_id, node).await? != expected.meaning {
+            return Err(STALE_REF.into());
+        }
+        Ok::<_, String>((current, backend_id))
+    }
+    .await;
+    result.map_err(|_| STALE_REF.to_string())
+}
