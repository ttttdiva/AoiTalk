@@ -0,0 +1,379 @@
+// AoiTalk Portable Bridge custom modification, 2026-10-10. Based on vercel-labs/agent-browser; see NOTICE-bridge-modifications.txt.
+//! Bounded, single-command stdin transport for the dedicated strict bridge.
+//! Values are never reparsed as process/global arguments or included in errors.
+use serde::Deserialize;
+use serde_json::{json, Value};
+use std::io::Read;
+
+pub const MAX_INPUT_BYTES: usize = 65_536;
+pub const INVALID_COMMAND: &str = "PRIVATE_COMMAND_INVALID: expected one allowed strict command";
+pub const INVALID_INPUT: &str = "PRIVATE_INPUT_INVALID: expected one bounded UTF-8 JSON command";
+pub const STRICT_CONFIG_REQUIRED: &str =
+    "STRICT_SESSION_REQUIRED: private commands require a dedicated strict config";
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Envelope {
+    argv: Vec<String>,
+}
+
+/// Read at most the limit plus one byte. serde rejects invalid UTF-8, duplicate
+/// fields, unknown fields, nested commands and trailing JSON/text. EOF is required.
+pub fn read_command(reader: impl Read) -> Result<Vec<String>, &'static str> {
+    let mut bytes = Vec::new();
+    reader
+        .take((MAX_INPUT_BYTES + 1) as u64)
+        .read_to_end(&mut bytes)
+        .map_err(|_| INVALID_INPUT)?;
+    if bytes.len() > MAX_INPUT_BYTES {
+        return Err(INVALID_INPUT);
+    }
+    let envelope: Envelope = serde_json::from_slice(&bytes).map_err(|_| INVALID_INPUT)?;
+    validate_argv(&envelope.argv)?;
+    Ok(envelope.argv)
+}
+
+/// Only the dedicated config path and JSON presentation may accompany the
+/// wrapper. In particular no browser/config/plugin overrides come from stdin.
+pub fn validate_outer(args: &[String]) -> Result<&str, &'static str> {
+    let mut config = None;
+    let mut command = false;
+    let mut stdin = false;
+    let mut json = false;
+    let mut i = 0;
+    while i < args.len() {
+        match args[i].as_str() {
+            "--config" if config.is_none() => {
+                i += 1;
+                config = Some(
+                    args.get(i)
+                        .filter(|s| !s.is_empty())
+                        .ok_or(STRICT_CONFIG_REQUIRED)?
+                        .as_str(),
+                );
+            }
+            "--json" if !json => json = true,
+            "bridge-command" if !command => command = true,
+            "--stdin" if !stdin => stdin = true,
+            _ => return Err(INVALID_COMMAND),
+        }
+        i += 1;
+    }
+    if !command || !stdin {
+        return Err(INVALID_COMMAND);
+    }
+    config.ok_or(STRICT_CONFIG_REQUIRED)
+}
+
+/// Fully consume a deliberately narrow grammar before the canonical parser.
+/// Positional text is a single literal string, never a shell command or flags.
+pub fn validate_argv(args: &[String]) -> Result<(), &'static str> {
+    let a: Vec<&str> = args.iter().map(String::as_str).collect();
+    let Some(command) = a.first().copied() else {
+        return Err(INVALID_COMMAND);
+    };
+    let rest = &a[1..];
+    let valid = match command {
+        "fill" => rest.len() == 2,
+        "type" => rest.len() == 2 && !matches!(rest[1], "--clear" | "--delay"),
+        "select" => rest.len() >= 2,
+        "dblclick" | "hover" | "check" | "uncheck" | "focus" | "clear" | "selectall"
+        | "scrollintoview" | "scrollinto" => rest.len() == 1,
+        "click" => {
+            rest.len() == 1 || (rest.len() == 2 && matches!(rest[1], "--new-tab" | "--human"))
+        }
+        "open" | "goto" | "navigate" => rest.len() == 1 && !rest[0].starts_with('-'),
+        "connect" | "reconnect" => rest.len() == 1 && !rest[0].starts_with('-'),
+        "back" | "forward" | "reload" | "close" | "quit" | "exit" => rest.is_empty(),
+        "session" => rest == ["info"],
+        "stream" => matches!(rest, ["status"] | ["disable"]),
+        "tab" => {
+            matches!(
+                rest,
+                [] | ["list"] | ["list", "--local-labels"] | ["new"] | ["close"]
+            ) || (rest.len() == 1 && !rest[0].starts_with('-'))
+                || (rest.len() == 2
+                    && matches!(rest[0], "new" | "close")
+                    && !rest[1].starts_with('-'))
+        }
+        "snapshot" => validate_snapshot(rest),
+        "crowdworks-inspect" => rest.is_empty(),
+        "scroll" => validate_scroll(rest),
+        "verify" => validate_verify(rest),
+        _ => false,
+    };
+    if valid {
+        Ok(())
+    } else {
+        Err(INVALID_COMMAND)
+    }
+}
+
+fn validate_snapshot(rest: &[&str]) -> bool {
+    let mut i = 0;
+    while i < rest.len() {
+        match rest[i] {
+            "-i" | "--interactive" | "-c" | "--compact" | "-C" | "--cursor" | "--delta"
+            | "--full" => {}
+            "--redact-editable-values" => {
+                if rest.get(i + 1) == Some(&"true") {
+                    i += 1;
+                }
+            }
+            "-d" | "--depth" => {
+                i += 1;
+                if rest.get(i).is_none_or(|v| v.parse::<u32>().is_err()) {
+                    return false;
+                }
+            }
+            "-s" | "--selector" => {
+                i += 1;
+                if rest.get(i).is_none_or(|v| v.is_empty()) {
+                    return false;
+                }
+            }
+            _ => return false,
+        }
+        i += 1;
+    }
+    true
+}
+
+fn validate_scroll(rest: &[&str]) -> bool {
+    let mut i = 0;
+    if rest
+        .first()
+        .is_some_and(|v| matches!(*v, "up" | "down" | "left" | "right"))
+    {
+        i += 1;
+    }
+    if rest.get(i).is_some_and(|v| v.parse::<u32>().is_ok()) {
+        i += 1;
+    }
+    if rest
+        .get(i)
+        .is_some_and(|v| matches!(*v, "-s" | "--selector"))
+    {
+        i += 2;
+        if i > rest.len() {
+            return false;
+        }
+    }
+    i == rest.len()
+}
+
+pub fn validate_verify(rest: &[&str]) -> bool {
+    if rest.is_empty() || !rest.len().is_multiple_of(2) {
+        return false;
+    }
+    let mut seen = std::collections::HashSet::new();
+    for pair in rest.as_chunks::<2>().0 {
+        if !matches!(
+            pair[0],
+            "--expected-url" | "--expected-text" | "--ref" | "--expected-value"
+        ) || !seen.insert(pair[0])
+        {
+            return false;
+        }
+        if pair[0] != "--expected-value" && pair[1].is_empty() {
+            return false;
+        }
+    }
+    seen.contains("--ref") == seen.contains("--expected-value")
+        && (seen.contains("--expected-url")
+            || seen.contains("--expected-text")
+            || seen.contains("--expected-value"))
+}
+
+/// Use a fixed public vocabulary rather than reflecting transport/renderer
+/// exceptions, parser arguments, policy text, or other private response fields.
+pub fn safe_error_code(error: &str) -> &'static str {
+    let code = error.split(':').next().unwrap_or("");
+    match code {
+        "outcome_unknown" => "outcome_unknown",
+        "tab_gone" => "tab_gone",
+        "rebind_pending" => "rebind_pending",
+        "connection_blocked" => "connection_blocked",
+        "connection_required" => "connection_required",
+        "STALE_REF" => "STALE_REF",
+        "FOCUS_CHANGED" => "FOCUS_CHANGED",
+        "STRICT_REFS_UNAVAILABLE" => "STRICT_REFS_UNAVAILABLE",
+        "REDACTION_UNAVAILABLE" => "REDACTION_UNAVAILABLE",
+        "SAFE_SNAPSHOT_UNAVAILABLE" => "SAFE_SNAPSHOT_UNAVAILABLE",
+        "SAFE_SNAPSHOT_REQUIRED" => "SAFE_SNAPSHOT_REQUIRED",
+        "STRICT_REF_REQUIRED" => "STRICT_REF_REQUIRED",
+        "STRICT_SESSION_REQUIRED" => "STRICT_SESSION_REQUIRED",
+        "STRICT_ACTION_UNSUPPORTED" => "STRICT_ACTION_UNSUPPORTED",
+        "STRICT_INPUT_UNSUPPORTED" => "STRICT_INPUT_UNSUPPORTED",
+        "EXACT_TARGET_REQUIRED" => "EXACT_TARGET_REQUIRED",
+        "TARGET_SELECTION_REQUIRED" => "TARGET_SELECTION_REQUIRED",
+        "DIALOG_BLOCKED" => "DIALOG_BLOCKED",
+        "PRIVATE_COMMAND_INVALID" => "PRIVATE_COMMAND_INVALID",
+        "PRIVATE_INPUT_INVALID" => "PRIVATE_INPUT_INVALID",
+        "VERIFY_UNAVAILABLE" => "VERIFY_UNAVAILABLE",
+        "VERIFY_INVALID" => "VERIFY_INVALID",
+        "CROWDWORKS_SCOPE_UNSUPPORTED" => "CROWDWORKS_SCOPE_UNSUPPORTED",
+        "CROWDWORKS_SCOPE_OVERFLOW" => "CROWDWORKS_SCOPE_OVERFLOW",
+        "CROWDWORKS_INSPECTION_UNAVAILABLE" => "CROWDWORKS_INSPECTION_UNAVAILABLE",
+        "target_unavailable" => "target_unavailable",
+        "invalid_endpoint" => "invalid_endpoint",
+        "unavailable" => "unavailable",
+        _ => "BRIDGE_ACTION_FAILED",
+    }
+}
+
+pub fn error_response(error: &str) -> Value {
+    let code = safe_error_code(error);
+    json!({"success":false,"error":code,"code":code,"data":{"executed":null}})
+}
+
+/// Keep bounded daemon evidence through the CLI's initial-launch projection.
+/// Never copy arbitrary daemon data, error prose, endpoints, or target IDs.
+pub fn error_response_with_data(error: &str, data: Option<&Value>) -> Value {
+    let mut response = error_response(error);
+    if data.and_then(|v| v.get("executed")) == Some(&Value::Bool(false)) {
+        response["data"]["executed"] = Value::Bool(false);
+    }
+    if response["code"] == "unavailable" {
+        if let Some(diagnostic) = data
+            .and_then(|v| v.get("connectionDiagnostic"))
+            .and_then(Value::as_str)
+            .filter(|v| {
+                matches!(
+                    *v,
+                    "websocket_timeout"
+                        | "websocket_connect_error"
+                        | "target_discovery_timeout"
+                        | "target_discovery_error"
+                        | "target_metadata_timeout"
+                        | "target_metadata_error"
+                )
+            })
+        {
+            response["data"]["connectionDiagnostic"] = json!(diagnostic);
+        }
+    }
+    response
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn bridge_cli_connection_diagnostics_preserve_only_fixed_failure_evidence() {
+        for diagnostic in [
+            "websocket_timeout",
+            "websocket_connect_error",
+            "target_discovery_timeout",
+            "target_discovery_error",
+            "target_metadata_timeout",
+            "target_metadata_error",
+        ] {
+            for executed in [Value::Null, json!(false), json!(true)] {
+                let data = json!({"executed":executed,"connectionDiagnostic":diagnostic,
+                    "url":"PRIVATE","targetId":"PRIVATE"});
+                let result = error_response_with_data("unavailable", Some(&data));
+                assert_eq!(result["data"]["connectionDiagnostic"], diagnostic);
+                assert_eq!(
+                    result["data"]["executed"],
+                    if executed == json!(false) {
+                        json!(false)
+                    } else {
+                        Value::Null
+                    }
+                );
+                assert_eq!(result["data"].as_object().unwrap().len(), 2);
+                assert!(!result.to_string().contains("PRIVATE"));
+                let other = error_response_with_data("outcome_unknown", Some(&data));
+                assert!(other["data"].get("connectionDiagnostic").is_none());
+            }
+        }
+        for diagnostic in [
+            json!("PRIVATE"),
+            json!("websocket_timeout PRIVATE"),
+            json!(false),
+            json!([]),
+            Value::Null,
+        ] {
+            let data = json!({"executed":"PRIVATE","connectionDiagnostic":diagnostic});
+            assert_eq!(
+                error_response_with_data("unavailable", Some(&data)),
+                error_response("unavailable")
+            );
+        }
+        assert_eq!(
+            error_response_with_data("unavailable", None),
+            error_response("unavailable")
+        );
+    }
+    #[test]
+    fn private_input_is_one_bounded_exact_envelope() {
+        let secret = "PRIVATE_SENTINEL_秘密";
+        let input = json!({"argv":["fill","@strict",secret]}).to_string();
+        assert_eq!(read_command(input.as_bytes()).unwrap()[2], secret);
+        for input in [
+            "{\"argv\":[\"back\"]} {\"argv\":[\"reload\"]}",
+            "{\"argv\":[\"back\"],\"other\":\"PRIVATE_SENTINEL\"}",
+            "{\"argv\":[\"back\"],\"argv\":[\"reload\"]}",
+            "{\"argv\":[[\"back\"]]}",
+            "{\"argv\":[1]}",
+            "[]",
+            "null",
+        ] {
+            assert_eq!(read_command(input.as_bytes()).unwrap_err(), INVALID_INPUT);
+        }
+        assert_eq!(read_command(&[0xff][..]).unwrap_err(), INVALID_INPUT);
+        let over = vec![b' '; MAX_INPUT_BYTES + 1];
+        assert_eq!(read_command(&over[..]).unwrap_err(), INVALID_INPUT);
+        let mut exact = json!({"argv":["back"]}).to_string().into_bytes();
+        exact.resize(MAX_INPUT_BYTES, b' ');
+        assert!(read_command(&exact[..]).is_ok());
+    }
+    #[test]
+    fn private_grammar_rejects_exports_nested_commands_and_trailing_flags() {
+        for argv in [
+            vec!["batch", "[]"],
+            vec!["bridge-command", "--stdin"],
+            vec!["eval", "PRIVATE_SENTINEL"],
+            vec!["back", "reload"],
+            vec!["fill", "@ref", "text", "--config", "elsewhere"],
+            vec!["snapshot", "--urls"],
+            vec!["snapshot", "--plugin", "x"],
+            vec!["close", "--all"],
+            vec!["verify"],
+            vec!["crowdworks-inspect", "--urls"],
+            vec!["crowdworks-inspect", "anything"],
+            vec!["verify", "--ref", "@ref"],
+            vec!["verify", "--expected-value", "x"],
+            vec!["verify", "--expected-text", "x", "--expected-text", "y"],
+            vec!["verify", "--expected-text", "x", "--config", "y"],
+        ] {
+            let args = argv.iter().map(|s| s.to_string()).collect::<Vec<_>>();
+            assert_eq!(validate_argv(&args).unwrap_err(), INVALID_COMMAND);
+        }
+        for argv in [
+            vec!["fill", "@ref", "--config"],
+            vec!["crowdworks-inspect"],
+            vec!["verify", "--expected-text", "x"],
+            vec!["verify", "--ref", "@ref", "--expected-value", ""],
+            vec!["snapshot", "--redact-editable-values"],
+        ] {
+            assert!(validate_argv(&argv.iter().map(|s| s.to_string()).collect::<Vec<_>>()).is_ok());
+        }
+    }
+    #[test]
+    fn private_errors_never_echo_exception_arguments() {
+        for error in [
+            "PRIVATE_SENTINEL",
+            "VERIFY_UNAVAILABLE: PRIVATE_SENTINEL",
+            "CROWDWORKS_SCOPE_UNSUPPORTED: PRIVATE_SENTINEL",
+            "CROWDWORKS_SCOPE_OVERFLOW: PRIVATE_SENTINEL",
+            "CROWDWORKS_INSPECTION_UNAVAILABLE: PRIVATE_SENTINEL",
+            "outcome_unknown: PRIVATE_SENTINEL",
+        ] {
+            let response = error_response(error);
+            assert!(!response.to_string().contains("PRIVATE_SENTINEL"));
+            assert_eq!(response["success"], false);
+        }
+    }
+}
