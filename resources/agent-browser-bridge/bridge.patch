+    close_current_browser(&mut state).await.unwrap();
+    let mut restarted = DaemonState::new();
+    let response = execute_command(&json!({"id":"routine","action":"launch","cdpUrl":browser.url,"attachTarget":"A","strictRefs":true}), &mut restarted).await;
