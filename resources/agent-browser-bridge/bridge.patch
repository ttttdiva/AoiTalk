+#[derive(Default)]
+struct EditableDom {
+    known: std::collections::HashSet<i64>,
+    editable: std::collections::HashSet<i64>,
+    descendants: std::collections::HashSet<i64>,
+    contains_editable: std::collections::HashSet<i64>,
+}
+
+fn dom_editable_metadata(node: &Value, inherited: bool, result: &mut EditableDom) -> bool {
+    let attributes = node["attributes"].as_array();
+    let contenteditable = attributes.is_some_and(|attrs| {
+        attrs.as_chunks::<2>().0.iter().any(|pair| {
+            pair[0].as_str() == Some("contenteditable")
+                && pair[1].as_str().is_some_and(|value| {
+                    value.is_empty()
+                        || value.eq_ignore_ascii_case("true")
+                        || value.eq_ignore_ascii_case("plaintext-only")
+                })
+        })
+    });
+    let editable = contenteditable
+        || matches!(
+            node["nodeName"].as_str(),
+            Some("INPUT" | "TEXTAREA" | "SELECT")
+        );
+    let sensitive = inherited || editable;
+    let id = node["backendNodeId"].as_i64();
+    if let Some(id) = id {
+        result.known.insert(id);
+        if editable {
+            result.editable.insert(id);
+        }
+        if sensitive {
+            result.descendants.insert(id);
+        }
+    }
+    let mut contains = editable;
+    for key in ["children", "shadowRoots", "pseudoElements"] {
+        if let Some(children) = node[key].as_array() {
+            for child in children {
+                contains |= dom_editable_metadata(child, sensitive, result);
+            }
+        }
+    }
+    for key in ["contentDocument", "templateContent", "importedDocument"] {
+        if let Some(child) = node.get(key) {
+            contains |= dom_editable_metadata(child, sensitive, result);
+        }
+    }
+    if contains {
+        if let Some(id) = id {
+            result.contains_editable.insert(id);
+        }
+    }
+    contains
+}
