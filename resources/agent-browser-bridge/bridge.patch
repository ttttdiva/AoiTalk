diff --git a/cli/src/native/cdp/targets.rs b/cli/src/native/cdp/targets.rs
new file mode 100644
index 0000000..c666c7d
--- /dev/null
+++ b/cli/src/native/cdp/targets.rs
@@ -0,0 +1,208 @@
+// AoiTalk Portable Bridge custom modification, 2026-10-10. Based on vercel-labs/agent-browser; see NOTICE-bridge-modifications.txt.
+//! One-shot discovery of eligible existing targets. This path deliberately uses
+//! the stock CDP transport without constructing a BrowserManager or a daemon.
+
+use serde_json::{json, Value};
+use std::time::Duration;
+
+use super::client::CdpClient;
+use super::types::GetTargetsResult;
+use crate::native::browser::should_track_target;
+
+const PROBE_TIMEOUT: Duration = Duration::from_secs(5);
+const INVALID_ENDPOINT: &str =
+    "invalid_cdp_endpoint: expected an explicit loopback browser WebSocket endpoint";
+
+/// Accept only the local browser endpoints supported by the bridge resolver.
+/// No HTTP discovery, hostname lookup, credential, query or fragment is used.
+/// Validate the raw authority too: URL normalization must not turn another
+/// spelling (such as 127.1) into an approved literal loopback address.
+pub fn validate_browser_ws_endpoint(endpoint: &str) -> Result<(), String> {
+    let rest = endpoint.strip_prefix("ws://").ok_or(INVALID_ENDPOINT)?;
+    let (authority, path) = rest.split_once('/').ok_or(INVALID_ENDPOINT)?;
+    let port = authority
+        .strip_prefix("127.0.0.1:")
+        .or_else(|| authority.strip_prefix("[::1]:"))
+        .ok_or(INVALID_ENDPOINT)?;
+    if port.is_empty()
+        || !port.bytes().all(|b| b.is_ascii_digit())
+        || !port.parse::<u16>().is_ok_and(|p| p > 0)
+    {
+        return Err(INVALID_ENDPOINT.to_string());
+    }
+    let valid_path = path == "devtools/browser"
+        || path.strip_prefix("devtools/browser/").is_some_and(|id| {
+            !id.is_empty()
+                && id
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_'))
+        });
+    if !valid_path {
+        return Err(INVALID_ENDPOINT.to_string());
+    }
+    Ok(())
+}
+
+/// Return minimal metadata using exactly Browser.getVersion and
+/// Target.getTargets. The returned target URL is reduced to an HTTP(S) origin;
+/// titles, credentials, paths, queries and fragments are never copied out.
+/// An empty eligible list is unavailable, rather than permission to create a tab.
+pub async fn discover_targets(endpoint: &str) -> Result<Value, String> {
+    validate_browser_ws_endpoint(endpoint)?;
+    let client = tokio::time::timeout(PROBE_TIMEOUT, CdpClient::connect(endpoint))
+        .await
+        .map_err(|_| "unavailable: CDP metadata connection timed out".to_string())?
+        .map_err(|_| "unavailable: cannot connect to the CDP metadata endpoint".to_string())?;
+    let result = tokio::time::timeout(PROBE_TIMEOUT, async {
+        let version = client
+            .send_command_no_params("Browser.getVersion", None)
+            .await
+            .map_err(|_| "unavailable: browser version metadata is unavailable".to_string())?;
+        let targets: GetTargetsResult = client
+            .send_command_typed("Target.getTargets", &json!({}), None)
+            .await
+            .map_err(|_| "unavailable: target metadata is unavailable".to_string())?;
+        let targets: Vec<Value> = targets
+            .target_infos
+            .into_iter()
+            .filter(should_track_target)
+            .map(|target| {
+                let mut value = json!({
+                    "targetId": target.target_id,
+                    "type": target.target_type,
+                });
+                if let Ok(url) = url::Url::parse(&target.url) {
+                    if matches!(url.scheme(), "http" | "https") {
+                        value["origin"] = json!(url.origin().ascii_serialization());
+                    }
+                }
+                value
+            })
+            .collect();
+        if targets.is_empty() {
+            return Err("unavailable: no eligible existing page targets".to_string());
+        }
+        Ok(json!({
+            "browser": {
+                "product": version.get("product").and_then(Value::as_str).unwrap_or_default(),
+                "protocolVersion": version.get("protocolVersion").and_then(Value::as_str).unwrap_or_default(),
+            },
+            "targets": targets,
+        }))
+    })
+    .await
+    .unwrap_or_else(|_| Err("unavailable: CDP metadata probe timed out".to_string()));
+    client.close().await;
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use futures_util::{SinkExt, StreamExt};
+    use tokio_tungstenite::tungstenite::Message;
+
+    #[test]
+    fn validates_only_explicit_loopback_browser_endpoints() {
+        for endpoint in [
+            "ws://127.0.0.1:9222/devtools/browser",
+            "ws://127.0.0.1:80/devtools/browser/id-1",
+            "ws://[::1]:65535/devtools/browser/id_2",
+        ] {
+            assert!(validate_browser_ws_endpoint(endpoint).is_ok(), "{endpoint}");
+        }
+        for endpoint in [
+            "9222",
+            "http://127.0.0.1:9222",
+            "wss://127.0.0.1:9222/devtools/browser/id",
+            "ws://localhost:9222/devtools/browser/id",
+            "ws://127.1:9222/devtools/browser/id",
+            "ws://127.0.0.2:9222/devtools/browser/id",
+            "ws://[::ffff:127.0.0.1]:9222/devtools/browser/id",
+            "ws://127.0.0.1/devtools/browser/id",
+            "ws://127.0.0.1:0/devtools/browser/id",
+            "ws://127.0.0.1:65536/devtools/browser/id",
+            "ws://secret@127.0.0.1:9222/devtools/browser/id",
+            "ws://127.0.0.1:9222/devtools/page/id",
+            "ws://127.0.0.1:9222/devtools/browser/",
+            "ws://127.0.0.1:9222/devtools/browser/id?secret=1",
+            "ws://127.0.0.1:9222/devtools/browser/id#secret",
+            "ws://127.0.0.1:9222/devtools/browser/id/more",
+            "ws://127.0.0.1:9222/devtools/browser/%69d",
+        ] {
+            let error = validate_browser_ws_endpoint(endpoint).unwrap_err();
+            assert_eq!(error, INVALID_ENDPOINT);
+            assert!(!error.contains(endpoint));
+        }
+    }
+
+    async fn metadata_server(targets: Value) -> (String, tokio::task::JoinHandle<Vec<Value>>) {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let endpoint = format!(
+            "ws://{}/devtools/browser/test",
+            listener.local_addr().unwrap()
+        );
+        let server = tokio::spawn(async move {
+            let (stream, _) = listener.accept().await.unwrap();
+            let mut ws = tokio_tungstenite::accept_async(stream).await.unwrap();
+            let mut commands = Vec::new();
+            while let Some(Ok(Message::Text(text))) = ws.next().await {
+                let command: Value = serde_json::from_str(&text).unwrap();
+                let result = match command["method"].as_str().unwrap() {
+                    "Browser.getVersion" => {
+                        json!({"product":"Chrome/test", "protocolVersion":"1.3", "userAgent":"private-agent"})
+                    }
+                    "Target.getTargets" => json!({"targetInfos":targets}),
+                    other => panic!("metadata probe sent forbidden method {other}"),
+                };
+                ws.send(Message::Text(
+                    json!({"id":command["id"],"result":result}).to_string(),
+                ))
+                .await
+                .unwrap();
+                commands.push(command);
+            }
+            commands
+        });
+        (endpoint, server)
+    }
+
+    #[tokio::test]
+    async fn probe_uses_two_metadata_methods_and_redacts_private_metadata() {
+        let (endpoint, server) = metadata_server(json!([
+            {"targetId":"A","type":"page","title":"private-title","url":"https://user:secret@example.com/private-path?token=hidden#fragment"},
+            {"targetId":"B","type":"webview","title":"private-title","url":"data:text/html,private-data"},
+            {"targetId":"C","type":"page","title":"internal","url":"chrome://settings"},
+            {"targetId":"D","type":"service_worker","title":"worker","url":"https://example.com/worker"}
+        ])).await;
+        let data = discover_targets(&endpoint).await.unwrap();
+        assert_eq!(data["targets"].as_array().unwrap().len(), 2);
+        assert_eq!(data["targets"][0]["origin"], "https://example.com");
+        assert!(data["targets"][1].get("origin").is_none());
+        for secret in [
+            "secret",
+            "private",
+            "token",
+            "hidden",
+            "fragment",
+            "userAgent",
+        ] {
+            assert!(!data.to_string().contains(secret));
+        }
+        let commands = server.await.unwrap();
+        assert_eq!(commands.len(), 2);
+        assert_eq!(commands[0]["method"], "Browser.getVersion");
+        assert_eq!(commands[1]["method"], "Target.getTargets");
+        assert!(commands.iter().all(|c| c.get("sessionId").is_none()));
+    }
+
+    #[tokio::test]
+    async fn probe_zero_targets_is_unavailable_without_creation() {
+        let (endpoint, server) = metadata_server(json!([])).await;
+        assert!(discover_targets(&endpoint)
+            .await
+            .unwrap_err()
+            .starts_with("unavailable:"));
+        assert_eq!(server.await.unwrap().len(), 2);
+    }
+}
