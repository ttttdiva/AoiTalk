+        }
+    }
+    let target = flags.attach_target.as_deref()?;
+    if target.is_empty() || target.trim() != target || target.chars().any(char::is_control) {
+        return Some("--attach-target requires a non-empty CDP target id");
+    }
+    if flags.auto_connect || flags.provider.is_some() {
+        return Some("--attach-target requires explicit --cdp or connect; auto-connect and providers are not supported");
+    }
+    if flags.cdp.is_none()
