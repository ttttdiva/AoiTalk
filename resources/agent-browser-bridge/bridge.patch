+#[tokio::test]
+async fn bridge_pending_handshake_cancellation_latches_without_another_socket() {
+    let (_env, _dir) = isolated_env();
+    assert_eq!(
+        super::super::browser::EXACT_TARGET_CONNECT_TIMEOUT,
+        std::time::Duration::from_secs(25)
+    );
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let endpoint = format!(
+        "ws://{}/devtools/browser/pending",
+        listener.local_addr().unwrap()
+    );
+    let count = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    let server_count = count.clone();
+    let server = tokio::spawn(async move {
+        let mut held = Vec::new();
+        loop {
+            let (stream, _) = listener.accept().await.unwrap();
+            held.push(stream);
+            server_count.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+        }
+    });
+    let mut state = DaemonState::new();
+    let launch = json!({"id":"pending","action":"launch","cdpUrl":endpoint,"attachTarget":"A","strictRefs":true});
+    assert!(tokio::time::timeout(
+        std::time::Duration::from_millis(50),
+        execute_command(&launch, &mut state)
+    )
+    .await
+    .is_err());
+    assert_eq!(count.load(std::sync::atomic::Ordering::SeqCst), 1);
+    assert!(tab_binding::connection_blocked(&state.session_id).unwrap());
+    for _ in 0..100 {
+        assert_eq!(
+            execute_command(&launch, &mut state).await["code"],
+            "connection_blocked"
+        );
+    }
+    let mut restarted = DaemonState::new();
+    assert_eq!(
+        execute_command(&launch, &mut restarted).await["code"],
+        "connection_blocked"
+    );
+    assert_eq!(count.load(std::sync::atomic::Ordering::SeqCst), 1);
+    server.abort();
+}
