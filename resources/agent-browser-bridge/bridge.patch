+    async fn exercise(change: &str, cards: usize) -> (Result<Value, String>, Vec<Value>) {
+        let (ax, dom) = fixture(cards);
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let url = format!(
+            "ws://{}/devtools/browser/cw-test",
+            listener.local_addr().unwrap()
+        );
+        let calls = Arc::new(Mutex::new(Vec::new()));
+        let captured = calls.clone();
+        let dispatch = change.starts_with("dispatch-");
+        let change = change
+            .strip_prefix("dispatch-")
+            .unwrap_or(change)
+            .to_string();
+        let full_dispatch = change.starts_with("full");
+        let inspecting = Arc::new(std::sync::atomic::AtomicBool::new(!dispatch));
+        let server_inspecting = inspecting.clone();
+        let server = tokio::spawn(async move {
+            let (socket, _) = listener.accept().await.unwrap();
+            let mut ws = tokio_tungstenite::accept_async(socket).await.unwrap();
+            let mut after = false;
+            while let Some(Ok(message)) = ws.next().await {
+                let Ok(text) = message.to_text() else {
+                    continue;
+                };
+                let request: Value = serde_json::from_str(text).unwrap();
+                captured.lock().unwrap().push(request.clone());
+                if request.get("sessionId").is_some() {
+                    assert_eq!(request["sessionId"], "session-a");
+                }
+                let is_inspecting = server_inspecting.load(std::sync::atomic::Ordering::SeqCst);
+                let result = match request["method"].as_str().unwrap() {
+                    "Target.getTargets" => {
+                        json!({"targetInfos": if after && change == "target-loss" {
+                            json!([{"targetId":"OTHER","type":"page","url":PAGE,"title":"PRIVATE_TITLE"}])
+                        } else {
+                            json!([{"targetId":"CHOSEN","type":"page","url":PAGE,"title":"PRIVATE_TITLE"},{"targetId":"OTHER","type":"page","url":PAGE,"title":"PRIVATE_TITLE"}])
+                        }})
+                    }
+                    "Target.attachToTarget" if !is_inspecting => {
+                        assert_eq!(request["params"]["targetId"], "CHOSEN");
+                        json!({"sessionId":"session-a"})
+                    }
+                    "Runtime.evaluate" if !is_inspecting => {
+                        json!({"result":{"type":"number","value":1}})
+                    }
+                    "Page.getFrameTree" => {
+                        json!({"frameTree":{"frame":{"id":if after && change=="frame" {"changed"} else {"main"},"loaderId":if after && matches!(change.as_str(),"navigation"|"reload") {"changed"} else {"loader"},"url":if after && change=="navigation" {"https://crowdworks.jp/public/jobs?changed"} else {"https://crowdworks.jp/public/jobs?private=query"},"urlFragment":if after && change=="fragment" {"#changed"} else {"#private"}}}})
+                    }
+                    "Page.createIsolatedWorld" => json!({"executionContextId":7}),
+                    "Runtime.evaluate" => {
+                        assert_eq!(request["params"]["expression"], "document");
+                        json!({"result":{"objectId":"document"}})
+                    }
+                    "DOM.describeNode" => {
+                        json!({"node":{"nodeName":"#document","backendNodeId":if after && change=="replacement" {2} else {1}}})
+                    }
+                    "Runtime.releaseObject" => json!({}),
+                    "Accessibility.getFullAXTree" => {
+                        assert_eq!(request["params"], json!({"frameId":"main"}));
+                        ax.clone()
+                    }
+                    "DOM.getDocument" => {
+                        after = true;
+                        if change == "transport" {
+                            break;
+                        }
+                        dom.clone()
+                    }
+                    "Target.setDiscoverTargets"
+                    | "WebMCP.enable"
+                    | "Page.enable"
+                    | "Runtime.enable"
+                    | "Network.enable"
+                    | "DOM.enable"
+                    | "Accessibility.enable"
+                    | "Page.setLifecycleEventsEnabled"
+                    | "Target.setAutoAttach"
+                    | "Runtime.runIfWaitingForDebugger"
+                        if !is_inspecting =>
+                    {
+                        json!({})
+                    }
+                    method => panic!("Forbidden inspection CDP method: {method}"),
+                };
+                ws.send(tokio_tungstenite::tungstenite::Message::Text(
+                    json!({"id":request["id"],"result":result}).to_string(),
+                ))
+                .await
+                .unwrap();
+            }
+        });
+        let result = if dispatch {
+            let manager = super::super::browser::BrowserManager::connect_cdp_target(&url, "CHOSEN")
+                .await
+                .unwrap();
+            calls.lock().unwrap().clear();
+            inspecting.store(true, std::sync::atomic::Ordering::SeqCst);
+            let mut state = super::super::actions::DaemonState::new();
+            state.strict_refs = true;
+            state.browser = Some(manager);
+            if full_dispatch {
+                state.session_id = format!("cw-test-{}", uuid::Uuid::new_v4());
+                state.policy = None;
+                state.confirm_actions = None;
+                let response =
+                    super::super::actions::test_crowdworks_dispatch_with_pending_iframe(&mut state)
+                        .await;
+                Ok(response)
+            } else {
+                super::super::actions::handle_crowdworks_inspect(&mut state).await
+            }
+        } else {
+            let client = CdpClient::connect(&url).await.unwrap();
+            inspect(&client, "session-a").await
+        };
+        let calls = calls.lock().unwrap().clone();
+        server.abort();
+        let _ = server.await;
+        (result, calls)
+    }
+
+    #[tokio::test]
+    async fn crowdworks_handler_validates_bound_target_without_selecting_or_reconnecting() {
+        let (result, calls) =
+            tokio::time::timeout(std::time::Duration::from_secs(5), exercise("dispatch-", 1))
+                .await
+                .unwrap();
+        assert_eq!(result.unwrap()["coverage"]["candidate_count"], 1);
+        assert_eq!(
+            calls
+                .iter()
+                .filter(|c| c["method"] == "Target.getTargets")
+                .count(),
+            2
+        );
+        assert_eq!(calls.len(), 14);
+        let (result, calls) = tokio::time::timeout(
+            std::time::Duration::from_secs(5),
+            exercise("dispatch-target-loss", 1),
+        )
+        .await
+        .unwrap();
+        assert!(result.unwrap_err().starts_with("tab_gone:"));
+        assert!(calls.iter().all(|c| !matches!(
