+        .parent()
+        .ok_or("connection_blocked: invalid connection directory")?;
+    fs::create_dir_all(dir).map_err(|_| "connection_blocked: cannot persist connection state")?;
+    let mut options = fs::OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
