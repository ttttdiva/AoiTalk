+pub(super) const STRICT_REFS_UNAVAILABLE: &str =
+    "STRICT_REFS_UNAVAILABLE: exact document identity could not be verified";
+const STALE_REF: &str = "STALE_REF: take a fresh snapshot";
+
+/// Opaque, local-only identities. No raw AX names, editable values or selectors
+/// are retained in the guard; the semantic comparison uses a digest.
+#[derive(Debug, Clone)]
+pub(super) struct StrictDocumentIdentity {
+    page_session: String,
+    session: String,
+    frame: String,
+    loader: String,
+    url_digest: Vec<u8>,
+    document_backend_id: i64,
+    execution_context_id: i64,
+}
+
+impl StrictDocumentIdentity {
+    /// Match a separately captured DOM root without exposing other identity fields.
+    pub(super) fn root_backend_id(&self) -> i64 {
+        self.document_backend_id
+    }
+}
+
+impl PartialEq for StrictDocumentIdentity {
+    fn eq(&self, other: &Self) -> bool {
+        // An isolated context is an ephemeral read capability, not the page's
+        // identity. Always use the newly acquired context for current checks.
+        self.page_session == other.page_session
+            && self.session == other.session
+            && self.frame == other.frame
+            && self.loader == other.loader
+            && self.url_digest == other.url_digest
+            && self.document_backend_id == other.document_backend_id
+    }
+}
+impl Eq for StrictDocumentIdentity {}
+
+#[derive(Debug, Clone)]
+pub(super) struct StrictRefIdentity {
+    document: StrictDocumentIdentity,
+    meaning: Vec<u8>,
+}
+
+fn frame_in_tree<'a>(tree: &'a Value, frame: Option<&str>) -> Option<&'a Value> {
+    if frame.is_none() || tree["frame"]["id"].as_str() == frame {
+        return Some(&tree["frame"]);
+    }
+    tree["childFrames"]
+        .as_array()?
+        .iter()
+        .find_map(|child| frame_in_tree(child, frame))
+}
+
+async fn release_strict_object(client: &CdpClient, session: &str, object: &str) {
+    // Best effort even after a failed describe/call. A lost CDP connection also
+    // destroys its handles; never replace the original guard error with cleanup.
+    let _ = client
+        .send_command(
+            "Runtime.releaseObject",
+            Some(serde_json::json!({
+                "objectId": object
+            })),
+            Some(session),
+        )
+        .await;
+}
+
+async fn describe_strict_document_object(
+    client: &CdpClient,
+    session: &str,
+    object: &str,
+) -> Result<i64, String> {
+    let described = client
+        .send_command(
+            "DOM.describeNode",
+            Some(serde_json::json!({
+                "objectId": object, "depth": 0
+            })),
+            Some(session),
+        )
+        .await;
+    release_strict_object(client, session, object).await;
+    let described = described?;
+    if described["node"]["nodeName"] != "#document" {
+        return Err(STALE_REF.into());
+    }
+    described["node"]["backendNodeId"]
+        .as_i64()
+        .ok_or_else(|| STALE_REF.into())
+}
+
+async fn document_backend_id(
+    client: &CdpClient,
+    session: &str,
+    frame: &str,
+) -> Result<(i64, i64), String> {
+    let world = client
+        .send_command(
+            "Page.createIsolatedWorld",
+            Some(serde_json::json!({
+                "frameId": frame, "worldName": "agent-browser-strict-refs"
+            })),
+            Some(session),
+        )
+        .await?;
+    let context = world["executionContextId"].as_i64().ok_or(STALE_REF)?;
+    let evaluated = client
+        .send_command(
+            "Runtime.evaluate",
+            Some(serde_json::json!({
+                "expression": "document", "contextId": context, "returnByValue": false
+            })),
+            Some(session),
+        )
+        .await?;
+    if evaluated.get("exceptionDetails").is_some() {
+        if let Some(object) = evaluated["result"]["objectId"].as_str() {
+            release_strict_object(client, session, object).await;
+        }
+        return Err(STALE_REF.into());
+    }
+    let object = evaluated["result"]["objectId"].as_str().ok_or(STALE_REF)?;
+    let backend = describe_strict_document_object(client, session, object).await?;
+    Ok((backend, context))
+}
+
+pub(super) async fn capture_strict_document(
+    client: &CdpClient,
+    page_session: &str,
+    session: &str,
+    frame: Option<&str>,
+    frame_tree: &Value,
+) -> Result<StrictDocumentIdentity, String> {
+    let result = async {
+        let frame = frame_in_tree(&frame_tree["frameTree"], frame).ok_or(STALE_REF)?;
+        let id = frame["id"]
+            .as_str()
+            .filter(|s| !s.is_empty())
+            .ok_or(STALE_REF)?;
+        let loader = frame["loaderId"]
+            .as_str()
+            .filter(|s| !s.is_empty())
+            .ok_or(STALE_REF)?;
+        let url = frame["url"]
+            .as_str()
+            .filter(|s| !s.is_empty())
+            .ok_or(STALE_REF)?;
+        // CDP Frame.url excludes the fragment; urlFragment is a separate,
+        // optional field. Keep neither raw string in the persisted guard.
+        let fragment = match frame.get("urlFragment") {
+            None => "",
+            Some(value) => value.as_str().ok_or(STALE_REF)?,
+        };
+        let url_digest =
+            Sha256::digest(serde_json::json!([url, fragment]).to_string().as_bytes()).to_vec();
+        let (document_backend_id, execution_context_id) =
+            document_backend_id(client, session, id).await?;
+        Ok::<_, String>(StrictDocumentIdentity {
+            page_session: page_session.to_string(),
+            session: session.to_string(),
+            frame: id.to_string(),
+            loader: loader.to_string(),
+            url_digest,
+            document_backend_id,
+            execution_context_id,
+        })
+    }
+    .await;
+    result.map_err(|_| STRICT_REFS_UNAVAILABLE.to_string())
+}
+
+async fn exact_node_meaning(
+    client: &CdpClient,
+    document: &StrictDocumentIdentity,
+    backend_id: i64,
+    ax: &Value,
+) -> Result<Vec<u8>, String> {
+    if ax["backendDOMNodeId"].as_i64() != Some(backend_id)
+        || ax["ignored"].as_bool() == Some(true)
+        || ax["role"]["value"].as_str().is_none()
+    {
+        return Err(STALE_REF.into());
+    }
+    let resolved = client
+        .send_command(
+            "DOM.resolveNode",
+            Some(serde_json::json!({
+                "backendNodeId": backend_id, "objectGroup": "agent-browser",
+                "executionContextId": document.execution_context_id
+            })),
+            Some(&document.session),
+        )
+        .await?;
+    let object = resolved["object"]["objectId"].as_str().ok_or(STALE_REF)?;
+    let destinations = async {
+        let owner = client.send_command("Runtime.callFunctionOn", Some(serde_json::json!({
+            "objectId": object,
+            "functionDeclaration": "function() { const get = (name) => Object.getOwnPropertyDescriptor(Node.prototype, name).get.call(this); return get('isConnected') ? get('ownerDocument') : null; }",
+            "returnByValue": false
+        })), Some(&document.session)).await?;
+        if owner.get("exceptionDetails").is_some() {
+            if let Some(owner_object) = owner["result"]["objectId"].as_str() {
+                release_strict_object(client, &document.session, owner_object).await;
+            }
+            return Err(STALE_REF.to_string());
+        }
+        let owner_object = owner["result"]["objectId"].as_str().ok_or(STALE_REF)?;
+        let owner_backend = describe_strict_document_object(client, &document.session, owner_object).await?;
+        if owner_backend != document.document_backend_id {
+            return Err(STALE_REF.into());
+        }
+        // Native getters in the isolated world avoid page-overridden getters.
+        // Preserve effective navigation/form semantics, including <base> and
+        // inherited form attributes, without retaining their raw destinations.
+        let effective = client.send_command("Runtime.callFunctionOn", Some(serde_json::json!({
+            "objectId": object,
+            "functionDeclaration": r#"function strictRefDestinations() {
+                const get = (prototype, name, element) => Object.getOwnPropertyDescriptor(prototype, name).get.call(element);
+                const has = name => Element.prototype.hasAttribute.call(this, name);
+                const doc = get(Node.prototype, 'ownerDocument', this);
+                const base = Document.prototype.querySelector.call(doc, 'base[target]');
+                const baseTarget = base ? get(HTMLBaseElement.prototype, 'target', base) : '';
+                const result = { href: null, target: null, form: null };
+                if (this instanceof HTMLAnchorElement) {
+                    result.href = get(HTMLAnchorElement.prototype, 'href', this);
+                    result.target = get(HTMLAnchorElement.prototype, 'target', this) || baseTarget;
+                }
+                if (this instanceof HTMLAreaElement) {
+                    result.href = get(HTMLAreaElement.prototype, 'href', this);
+                    result.target = get(HTMLAreaElement.prototype, 'target', this) || baseTarget;
+                }
+                if (typeof SVGAElement !== 'undefined' && this instanceof SVGAElement) {
+                    const href = get(SVGAnimatedString.prototype, 'baseVal', get(SVGAElement.prototype, 'href', this));
+                    result.href = new URL(href, get(Node.prototype, 'baseURI', this)).href;
+                    result.target = get(SVGAnimatedString.prototype, 'baseVal', get(SVGAElement.prototype, 'target', this)) || baseTarget;
+                }
+                const control = this instanceof HTMLButtonElement ? HTMLButtonElement.prototype
+                    : this instanceof HTMLInputElement ? HTMLInputElement.prototype : null;
+                if (control) {
+                    const type = get(control, 'type', this);
+                    const form = get(control, 'form', this);
+                    if (form && (type === 'submit' || type === 'image')) {
+                        result.form = {
+                            action: has('formaction') ? get(control, 'formAction', this) : get(HTMLFormElement.prototype, 'action', form),
+                            method: has('formmethod') ? get(control, 'formMethod', this) : get(HTMLFormElement.prototype, 'method', form),
+                            target: (has('formtarget') ? get(control, 'formTarget', this) : get(HTMLFormElement.prototype, 'target', form)) || baseTarget,
+                            enctype: has('formenctype') ? get(control, 'formEnctype', this) : get(HTMLFormElement.prototype, 'enctype', form),
+                            noValidate: get(control, 'formNoValidate', this) || get(HTMLFormElement.prototype, 'noValidate', form)
+                        };
+                    }
+                }
+                return result;
+            }"#,
+            "returnByValue": true
+        })), Some(&document.session)).await?;
+        if effective.get("exceptionDetails").is_some() {
+            return Err(STALE_REF.into());
+        }
+        effective["result"]["value"].as_object().cloned().map(Value::Object).ok_or_else(|| STALE_REF.into())
+    }.await;
+    release_strict_object(client, &document.session, object).await;
+    let destinations = destinations?;
+    let described = client
+        .send_command(
+            "DOM.describeNode",
+            Some(serde_json::json!({
+                "backendNodeId": backend_id, "depth": 0
+            })),
+            Some(&document.session),
+        )
+        .await?;
+    let node = &described["node"];
+    if node["backendNodeId"].as_i64() != Some(backend_id) {
+        return Err(STALE_REF.into());
+    }
+    let tag = node["nodeName"]
+        .as_str()
+        .filter(|s| !s.is_empty())
+        .ok_or(STALE_REF)?;
+    let mut attributes = std::collections::BTreeMap::new();
+    if let Some(attrs) = node["attributes"].as_array() {
+        for pair in attrs.as_chunks::<2>().0 {
+            if let Some(name) = pair[0].as_str() {
+                if [
+                    "type",
+                    "role",
+                    "href",
+                    "formaction",
+                    "action",
+                    "method",
+                    "target",
+                    "formtarget",
+                    "contenteditable",
+                    "disabled",
+                    "readonly",
+                    "aria-disabled",
+                    "aria-readonly",
+                    "aria-haspopup",
+                    "aria-pressed",
+                    "aria-expanded",
+                    "aria-checked",
+                    "aria-label",
+                    "aria-labelledby",
+                    "title",
+                    "download",
+                ]
+                .contains(&name)
+                {
+                    attributes.insert(name, &pair[1]);
+                }
+            }
+        }
+    }
+    let meaning = serde_json::json!({
+        "tag": tag, "attributes": attributes, "destinations": destinations, "role": ax["role"]["value"],
+        "name": ax["name"]["value"], "description": ax["description"]["value"]
+    });
+    Ok(Sha256::digest(meaning.to_string().as_bytes()).to_vec())
+}
+
+pub(super) async fn capture_strict_ref(
+    client: &CdpClient,
+    document: &StrictDocumentIdentity,
+    backend_id: i64,
+    ax: &Value,
+) -> Result<StrictRefIdentity, String> {
+    let meaning = exact_node_meaning(client, document, backend_id, ax)
+        .await
+        .map_err(|_| STRICT_REFS_UNAVAILABLE.to_string())?;
+    Ok(StrictRefIdentity {
+        document: document.clone(),
+        meaning,
+    })
+}
+
+/// Fail closed before scrolling or interacting. The caller must pass a ref,
+/// and every identity and semantic check must succeed on the exact old node.
+/// This is a pre-action guard, not an atomic DOM transaction.
