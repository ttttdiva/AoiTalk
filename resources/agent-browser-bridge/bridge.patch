+    }
+
+    #[tokio::test]
+    async fn crowdworks_full_dispatch_does_not_resume_queued_iframe_or_leak_epilogues() {
+        let (response, calls) = tokio::time::timeout(
+            std::time::Duration::from_secs(5),
+            exercise("dispatch-full", 1),
+        )
+        .await
+        .unwrap();
+        let response = response.unwrap();
+        assert_eq!(response["success"], true, "{response}");
+        assert_eq!(response["data"].as_object().unwrap().len(), 4);
+        assert!(!response.to_string().contains("PRIVATE"));
+        assert!(!response.to_string().contains("lifecycle"));
+        assert_eq!(calls.len(), 15);
+        let (response, _) = tokio::time::timeout(
+            std::time::Duration::from_secs(5),
+            exercise("dispatch-full-overflow", MAX_CANDIDATES + 1),
+        )
+        .await
+        .unwrap();
+        let response = response.unwrap();
+        assert_eq!(response["success"], false);
+        assert_eq!(response["code"], OVERFLOW);
+        assert_eq!(response["error"], OVERFLOW);
+        assert_eq!(response["data"], json!({"executed":false}));
+    }
+
+    #[tokio::test]
+    async fn crowdworks_document_guard_rejects_navigation_reload_fragment_and_replacement() {
+        for change in [
+            "navigation",
+            "reload",
+            "fragment",
+            "replacement",
+            "frame",
+            "transport",
+        ] {
+            let (result, calls) = exercise(change, 1).await;
+            assert_eq!(result.unwrap_err(), UNAVAILABLE, "{change}");
+            assert_eq!(
+                calls
+                    .iter()
+                    .filter(|c| c["method"] == "Accessibility.getFullAXTree")
+                    .count(),
+                1
+            );
+            assert_eq!(
+                calls
+                    .iter()
+                    .filter(|c| c["method"] == "DOM.getDocument")
+                    .count(),
+                1
+            );
+        }
+    }
+
+    #[tokio::test]
+    async fn crowdworks_document_race_takes_precedence_over_read_only_overflow() {
+        let (result, _) = exercise("navigation", MAX_CANDIDATES + 1).await;
+        assert_eq!(result.unwrap_err(), UNAVAILABLE);
+    }
+
+    #[tokio::test]
+    async fn crowdworks_cdp_calls_are_constant_per_observation_and_never_replay() {
+        let (small, small_calls) = exercise("", 1).await;
+        let (large, large_calls) = exercise("", 100).await;
+        assert_eq!(small.unwrap()["coverage"]["candidate_count"], 1);
+        assert_eq!(large.unwrap()["coverage"]["candidate_count"], 100);
+        assert_eq!(small_calls.len(), large_calls.len());
+        assert_eq!(small_calls.len(), 12);
+        for method in ["Accessibility.getFullAXTree", "DOM.getDocument"] {
+            assert_eq!(
+                large_calls.iter().filter(|c| c["method"] == method).count(),
+                1
+            );
+        }
+    }
+}
