+#[tokio::test]
+async fn bridge_fixed_initial_target_preserves_explicit_rebind_after_restart() {
+    let (_env, _dir) = isolated_env();
+    let browser = SyntheticBrowser::start(None).await;
+    let mut state = DaemonState::new();
+    let connect = json!({"id":"connect","action":"launch","cdpUrl":browser.url,"attachTarget":"A","attachTargetExplicit":true,"strictRefs":true,"webmcp":false});
+    let response = execute_command(&connect, &mut state).await;
+    assert_eq!(response["success"], true, "{response}");
+    let response = execute_command(
+        &json!({"id":"new","action":"tab_new","strictRefs":true}),
+        &mut state,
+    )
+    .await;
+    assert_eq!(response["success"], true, "{response}");
+    assert_eq!(state.browser.as_ref().unwrap().bound_target_id(), Some("B"));
+    assert!(!tab_binding::rebind_pending(&state.session_id).unwrap());
+    // Routine CLI prelude retains the fixed initial selector, but must not rebind.
+    let routine = json!({"id":"routine","action":"launch","cdpUrl":browser.url,"attachTarget":"A","strictRefs":true,"webmcp":false});
+    let response = execute_command(&routine, &mut state).await;
+    assert_eq!(response["success"], true, "{response}");
+    assert_eq!(state.browser.as_ref().unwrap().bound_target_id(), Some("B"));
+    close_current_browser(&mut state).await.unwrap();
+    let mut restarted = DaemonState::new();
+    let response = execute_command(&routine, &mut restarted).await;
+    assert_eq!(response["success"], true, "{response}");
+    assert_eq!(
+        restarted.browser.as_ref().unwrap().bound_target_id(),
+        Some("B")
+    );
+    assert_eq!(
+        browser
+            .methods
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|method| *method == "Target.createTarget")
+            .count(),
+        1
+    );
+    close_current_browser(&mut restarted).await.unwrap();
+}
