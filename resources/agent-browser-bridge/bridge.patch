+/// A durable, payload-free intent marker. Its presence is authoritative even
+/// if a previous process stopped before writing the marker contents.
+fn rebind_path(session: &str) -> PathBuf {
+    crate::connection::get_socket_dir().join(format!("{}.target.pending", session))
+}
+
+/// Whether an explicit rebind has an unresolved outcome. Metadata errors are
+/// errors, never an absent marker. Symlinks (including dangling ones) and other
+/// unexpected file types also count as pending, so they cannot bypass the gate.
+pub fn rebind_pending(session: &str) -> Result<bool, String> {
+    match fs::symlink_metadata(rebind_path(session)) {
+        Ok(_) => Ok(true),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(false),
+        Err(_) => Err("rebind_pending: cannot verify existing-target binding intent".to_string()),
+    }
+}
+
+/// Record intent before issuing a target-changing command. Existing or partly
+/// written markers are never replaced. On any error the caller must not act;
+/// a file already created by this attempt is deliberately retained.
+pub fn begin_rebind(session: &str) -> Result<(), String> {
+    let path = rebind_path(session);
+    let dir = path
+        .parent()
+        .ok_or("rebind_pending: invalid binding directory")?;
+    fs::create_dir_all(dir)
+        .map_err(|_| "rebind_pending: cannot create binding intent directory".to_string())?;
+    let mut options = fs::OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    let mut file = options.open(&path).map_err(|_| {
+        "rebind_pending: cannot record intent; recover the binding before retrying".to_string()
+    })?;
+    file.write_all(b"pending\n")
+        .and_then(|_| file.sync_all())
+        .map_err(|_| {
+            "rebind_pending: cannot sync binding intent; no action was taken".to_string()
+        })?;
+    sync_binding_directory(dir).map_err(|_| {
+        "rebind_pending: cannot sync binding intent directory; no action was taken".to_string()
+    })
+}
+
+/// A failed/in-flight strict connection attempt survives daemon restart. No
+/// automatic reset is provided: an authorized fresh session is the recovery
+/// boundary, so retrying a command cannot create another consent prompt.
+fn connection_block_path(session: &str) -> PathBuf {
+    crate::connection::get_socket_dir().join(format!("{}.connection-blocked", session))
