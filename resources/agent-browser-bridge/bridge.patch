+                let response = error_response("diagnostic", &error);
+                assert_eq!(response["code"], "unavailable");
+                for executed in [None, Some(false), Some(true)] {
+                    let data = strict_failure_data("launch", "unavailable", &error, executed);
+                    assert_eq!(data["connectionDiagnostic"], expected);
+                    let expected_executed = if executed == Some(false) {
