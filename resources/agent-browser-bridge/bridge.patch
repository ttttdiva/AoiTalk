+/// Preserve only fixed connection-stage evidence before stripping error prose.
+/// The six messages originate in the existing strict BrowserManager path; no
+/// arbitrary exception, endpoint, target, or caller-supplied data is reflected.
+fn strict_failure_data(action: &str, code: &str, error: &str, executed: Option<bool>) -> Value {
+    // These fixed inspection failures precede an input action. Transport and
+    // connection failures keep the existing unknown execution outcome.
+    let read_only_rejected = action == "crowdworks_inspect"
+        && matches!(
+            code,
+            "CROWDWORKS_SCOPE_UNSUPPORTED"
+                | "CROWDWORKS_SCOPE_OVERFLOW"
+                | "PRIVATE_COMMAND_INVALID"
+        );
+    // A confirmed focus rejection before the first clear/insert is recoverable
+    // without replacing the connection. Never infer this from the code alone.
+    let input_focus_rejected = matches!(action, "fill" | "type")
+        && executed != Some(true)
+        && code == "FOCUS_CHANGED"
+        && error == super::interaction::STRICT_INPUT_FOCUS_REQUIRED;
+    let mut data = json!({
+        "executed": if executed == Some(false) || read_only_rejected || input_focus_rejected { Some(false) } else { None }
+    });
+    if action == "launch" && code == "unavailable" {
+        let diagnostic = match error
+            .strip_prefix("CDP connection failed: ")
+            .unwrap_or(error)
+        {
+            "unavailable: existing-target connection timed out" => Some("websocket_timeout"),
+            "unavailable: cannot connect to the existing-target endpoint" => {
+                Some("websocket_connect_error")
+            }
+            "unavailable: target lifecycle metadata timed out" => Some("target_discovery_timeout"),
+            "unavailable: target lifecycle metadata is unavailable" => {
+                Some("target_discovery_error")
+            }
+            "unavailable: target metadata check timed out" => Some("target_metadata_timeout"),
+            "unavailable: target metadata check failed" => Some("target_metadata_error"),
+            _ => None,
+        };
+        if let Some(diagnostic) = diagnostic {
+            data["connectionDiagnostic"] = json!(diagnostic);
+        }
+    }
+    data
+}
