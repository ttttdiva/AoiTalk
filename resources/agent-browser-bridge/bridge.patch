+/// Evaluate assertions inside isolated worlds in the selected target. Only a
+/// boolean crosses CDP: document text, complete URL and control values are not
+/// exported. Identity is checked before and after; no selector/role fallback.
+pub(super) async fn verify_local_predicates(
+    client: &CdpClient,
+    page_session: &str,
+    ref_map: &RefMap,
+    iframe_sessions: &HashMap<String, String>,
+    expected_url: Option<&str>,
+    expected_text: Option<&str>,
+    expected_value: Option<(&str, &str)>,
+) -> Result<bool, String> {
+    const UNAVAILABLE: &str = "VERIFY_UNAVAILABLE: local assertion could not be verified";
+    let result = async {
+        let tree = client.send_command_no_params("Page.getFrameTree", Some(page_session)).await?;
+        let document = capture_strict_document(client, page_session, page_session, None, &tree).await?;
+        let mut matched = true;
+        if expected_url.is_some() || expected_text.is_some() {
+            let resolved = client.send_command("DOM.resolveNode", Some(serde_json::json!({
+                "backendNodeId":document.document_backend_id,
+                "executionContextId":document.execution_context_id,
+                "objectGroup":"agent-browser"
+            })), Some(page_session)).await?;
+            let object = resolved["object"]["objectId"].as_str().ok_or(UNAVAILABLE)?;
+            let evaluated = client.send_command("Runtime.callFunctionOn", Some(serde_json::json!({
+                "objectId":object,
+                "functionDeclaration":r#"function bridgeVerifyDocument(expectedUrl, expectedText) {
+                    const get = (prototype, name, receiver) => Object.getOwnPropertyDescriptor(prototype, name).get.call(receiver);
+                    if (!(this instanceof Document) || this !== document) throw new Error('VERIFY_UNAVAILABLE');
+                    let matched = true;
+                    if (expectedUrl !== null) matched = get(Document.prototype, 'URL', this).replace(/\/+$/, '') === expectedUrl.replace(/\/+$/, '') && matched;
+                    if (expectedText !== null) {
+                        const body = get(Document.prototype, 'body', this);
+                        if (!(body instanceof HTMLElement)) throw new Error('VERIFY_UNAVAILABLE');
+                        const normalize = value => String.prototype.trim.call(String.prototype.replace.call(value, /\s+/g, ' '));
+                        matched = String.prototype.includes.call(normalize(get(HTMLElement.prototype, 'innerText', body)), normalize(expectedText)) && matched;
+                    }
+                    return matched;
+                }"#,
+                "arguments":[{"value":expected_url},{"value":expected_text}],
+                "returnByValue":true
+            })),Some(page_session)).await;
+            release_strict_object(client,page_session,object).await;
+            matched &= verified_boolean(&evaluated?)?;
+        }
+        if let Some((reference, expected)) = expected_value {
+            let (target_document, backend) = validated_strict_target(client,page_session,ref_map,reference,iframe_sessions).await?;
+            let resolved = client.send_command("DOM.resolveNode",Some(serde_json::json!({
+                "backendNodeId":backend,"executionContextId":target_document.execution_context_id,
+                "objectGroup":"agent-browser"
+            })),Some(&target_document.session)).await?;
+            let object = resolved["object"]["objectId"].as_str().ok_or(UNAVAILABLE)?;
+            let evaluated = client.send_command("Runtime.callFunctionOn",Some(serde_json::json!({
+                "objectId":object,
+                "functionDeclaration":r#"function bridgeVerifyValue(expected) {
+                    const get = (prototype, name, receiver) => Object.getOwnPropertyDescriptor(prototype, name).get.call(receiver);
+                    if (!get(Node.prototype, 'isConnected', this) || get(Node.prototype, 'ownerDocument', this) !== document) throw new Error('VERIFY_UNAVAILABLE');
+                    let prototype;
+                    if (this instanceof HTMLInputElement) prototype = HTMLInputElement.prototype;
+                    else if (this instanceof HTMLTextAreaElement) prototype = HTMLTextAreaElement.prototype;
+                    else if (this instanceof HTMLSelectElement) prototype = HTMLSelectElement.prototype;
+                    else throw new Error('VERIFY_UNAVAILABLE');
+                    return get(prototype, 'value', this) === expected;
+                }"#,
+                "arguments":[{"value":expected}],"returnByValue":true
+            })),Some(&target_document.session)).await;
+            release_strict_object(client,&target_document.session,object).await;
+            matched &= verified_boolean(&evaluated?)?;
+            let (after, current_backend) = validated_strict_target(client,page_session,ref_map,reference,iframe_sessions).await?;
+            if after != target_document || current_backend != backend { return Err(UNAVAILABLE.to_string()); }
+        }
+        let tree = client.send_command_no_params("Page.getFrameTree",Some(page_session)).await?;
+        let after = capture_strict_document(client,page_session,page_session,None,&tree).await?;
+        if after != document { return Err(UNAVAILABLE.to_string()); }
+        Ok::<bool,String>(matched)
+    }.await;
+    result.map_err(|_| UNAVAILABLE.to_string())
+}
+
+fn verified_boolean(response: &Value) -> Result<bool, String> {
+    if response.get("exceptionDetails").is_some() || response["result"]["type"] != "boolean" {
+        return Err("VERIFY_UNAVAILABLE: local assertion failed".into());
+    }
+    response["result"]["value"]
+        .as_bool()
+        .ok_or_else(|| "VERIFY_UNAVAILABLE: local assertion failed".into())
+}
