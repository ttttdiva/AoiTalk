+/// Form the subprocess invocation without ever copying private operands into
+/// argv. The child applies the same bounded envelope and canonical parser.
+fn private_invocation(
+    arguments: &Value,
+    verify: bool,
+) -> Result<(Vec<String>, String), ProtocolError> {
+    validate_arguments_object(arguments)?;
+    let allowed: &[&str] = if verify {
+        &[
+            "configPath",
+            "expectedUrl",
+            "expectedText",
+            "expectedValue",
+            "ref",
+            "timeoutMs",
+        ]
+    } else {
+        &["configPath", "argv", "timeoutMs"]
+    };
+    if arguments
+        .as_object()
+        .unwrap()
+        .keys()
+        .any(|key| !allowed.contains(&key.as_str()))
+    {
+        return Err(ProtocolError::invalid_params("PRIVATE_COMMAND_INVALID"));
+    }
+    let config = required_string(arguments, "configPath")?;
+    if config.is_empty() {
+        return Err(ProtocolError::invalid_params("STRICT_SESSION_REQUIRED"));
+    }
+    let command = if verify {
+        let mut argv = vec!["verify".to_string()];
+        for (key, flag) in [
+            ("expectedUrl", "--expected-url"),
+            ("expectedText", "--expected-text"),
+            ("ref", "--ref"),
+            ("expectedValue", "--expected-value"),
+        ] {
+            if let Some(value) = optional_string(arguments, key)? {
+                argv.extend([flag.to_string(), value]);
+            }
+        }
+        argv
+    } else {
+        required_string_array(arguments, "argv")?
+    };
+    // Local GUI title projection is never an MCP/model-facing export.
+    if command.first().is_some_and(|arg| arg == "tab")
+        && command.iter().any(|arg| arg == "--local-labels")
+    {
+        return Err(ProtocolError::invalid_params("PRIVATE_COMMAND_INVALID"));
+    }
+    let body = json!({"argv":command}).to_string();
+    crate::bridge_private::read_command(body.as_bytes())
+        .map_err(|_| ProtocolError::invalid_params("PRIVATE_COMMAND_INVALID"))?;
+    Ok((
+        vec![
+            "--config".into(),
+            config,
+            "--json".into(),
+            "bridge-command".into(),
+            "--stdin".into(),
+        ],
+        body,
+    ))
+}
+
+fn call_private_command(arguments: &Value, verify: bool) -> Result<Value, ProtocolError> {
+    let (args, body) = private_invocation(arguments, verify)?;
+    let run = run_cli(&args, Some(body), optional_timeout(arguments)?)
+        .map_err(|_| ProtocolError::invalid_params("PRIVATE_COMMAND_FAILED"))?;
