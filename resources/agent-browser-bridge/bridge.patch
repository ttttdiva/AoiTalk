+                properties.iter().any(|p| {
+                    p["name"].as_str() == Some("editable")
+                        && matches!(&p["value"]["value"], Value::Bool(true) | Value::String(_))
+                })
+            });
+        roots[i] = editable;
+        if editable || backend.is_some_and(|id| metadata.descendants.contains(&id)) {
+            stack.push(i);
+        }
+    }
+    while let Some(i) = stack.pop() {
