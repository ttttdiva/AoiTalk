+/// Observe only an already selected exact main-frame target; validate it again
+/// before releasing any projection. The handler never binds another target.
+pub(super) async fn handle_crowdworks_inspect(state: &mut DaemonState) -> Result<Value, String> {
+    if !state.strict_refs {
+        return Err("STRICT_SESSION_REQUIRED".into());
+    }
+    if state.active_frame_id.is_some() {
+        return Err(super::crowdworks::UNSUPPORTED.into());
+    }
+    let mgr = state
+        .browser
+        .as_mut()
+        .ok_or(super::crowdworks::UNAVAILABLE)?;
+    if !mgr.exact_target_mode() {
+        return Err("EXACT_TARGET_REQUIRED".into());
+    }
+    mgr.validate_bound_target().await?;
+    let session = mgr.active_session_id()?.to_string();
+    let target = mgr.active_target_id()?.to_string();
+    let data = super::crowdworks::inspect(&mgr.client, &session).await;
+    if data.as_ref().is_err_and(|error| {
+        !matches!(
+            error.as_str(),
+            super::crowdworks::UNSUPPORTED | super::crowdworks::OVERFLOW
+        )
+    }) {
+        return data;
+    }
+    mgr.validate_bound_target().await?;
+    if mgr.active_session_id()? != session || mgr.active_target_id()? != target {
+        return Err(super::crowdworks::UNAVAILABLE.into());
+    }
+    data
+}
