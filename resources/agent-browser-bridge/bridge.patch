+        &state.iframe_sessions,
+        cmd.get("expectedUrl").and_then(Value::as_str),
+        cmd.get("expectedText").and_then(Value::as_str),
+        expected_value,
+    )
+    .await?;
+    Ok(json!({"matched":matched}))
+}
