+#[cfg(windows)]
+struct SuppressInheritedStandardHandles(Vec<(windows_sys::Win32::Foundation::HANDLE, u32)>);
+
+#[cfg(windows)]
+impl SuppressInheritedStandardHandles {
+    fn new() -> Result<Self, String> {
+        use windows_sys::Win32::Foundation::{
+            GetHandleInformation, SetHandleInformation, HANDLE_FLAG_INHERIT, INVALID_HANDLE_VALUE,
+        };
+        use windows_sys::Win32::System::Console::{
+            GetStdHandle, STD_ERROR_HANDLE, STD_INPUT_HANDLE, STD_OUTPUT_HANDLE,
+        };
+        let mut guard = Self(Vec::new());
+        for kind in [STD_INPUT_HANDLE, STD_OUTPUT_HANDLE, STD_ERROR_HANDLE] {
+            let handle = unsafe { GetStdHandle(kind) };
+            if handle == 0
+                || handle == INVALID_HANDLE_VALUE
+                || guard.0.iter().any(|(old, _)| *old == handle)
+            {
+                continue;
+            }
+            let mut flags = 0;
+            if unsafe { GetHandleInformation(handle, &mut flags) } == 0
+                || unsafe { SetHandleInformation(handle, HANDLE_FLAG_INHERIT, 0) } == 0
+            {
+                return Err("Cannot isolate daemon standard handles".into());
+            }
+            guard.0.push((handle, flags));
+        }
+        Ok(guard)
+    }
+}
+
+#[cfg(windows)]
+impl Drop for SuppressInheritedStandardHandles {
+    fn drop(&mut self) {
+        use windows_sys::Win32::Foundation::{SetHandleInformation, HANDLE_FLAG_INHERIT};
+        for (handle, flags) in &self.0 {
+            unsafe {
+                SetHandleInformation(*handle, HANDLE_FLAG_INHERIT, *flags & HANDLE_FLAG_INHERIT);
+            }
+        }
+    }
+}
