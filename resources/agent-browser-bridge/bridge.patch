+            let error = manager.tab_close(None, None).await.unwrap_err();
+            assert!(error.starts_with("outcome_unknown:"), "{outcome}: {error}");
+            assert!(!error.contains("secret"));
+            assert_eq!(manager.page_count(), 1);
+            assert_eq!(manager.bound_target_id(), Some("CHOSEN"));
+            assert_eq!(
+                state
+                    .commands
+                    .lock()
+                    .unwrap()
+                    .iter()
+                    .filter(|c| c["method"] == "Target.closeTarget")
+                    .count(),
+                1
+            );
+            assert_no_implicit_mutations(&state);
+            manager.close().await.unwrap();
+        }
+    }
+
+    #[tokio::test]
+    async fn exact_explicit_target_selection_can_rebind() {
+        let (url, state) = mock(&["CHOSEN", "OTHER"]).await;
+        let mut manager = BrowserManager::connect_cdp_target(&url, "CHOSEN")
+            .await
+            .unwrap();
+        assert_no_implicit_mutations(&state);
+        let id = manager.ensure_target_attached("OTHER").await.unwrap();
+        manager.tab_switch_by_id(id, None).await.unwrap();
+        assert_eq!(manager.bound_target_id(), Some("OTHER"));
+        assert!(manager.exact_target_mode());
+        manager.close().await.unwrap();
+    }
+}
