+/// Recheck exact identity and native deep focus immediately before text input.
+/// Closed shadow hosts whose deep target cannot be proved fail closed; a node
+/// inside a closed root can still be verified through its own root/host chain.
+pub async fn validate_strict_focus(
+    client: &CdpClient,
+    page_session: &str,
+    ref_map: &RefMap,
+    selector_or_ref: &str,
+    iframe_sessions: &HashMap<String, String>,
+) -> Result<(), String> {
+    const FOCUS_CHANGED: &str = "FOCUS_CHANGED";
+    const FOCUS_UNAVAILABLE: &str = "FOCUS_UNAVAILABLE";
+    let (document, backend_id) = validated_strict_target(
+        client,
+        page_session,
+        ref_map,
+        selector_or_ref,
+        iframe_sessions,
+    )
+    .await?;
+    let result = async {
+        let described = client.send_command("DOM.describeNode", Some(serde_json::json!({
+            "backendNodeId": backend_id, "depth": 1, "pierce": true
+        })), Some(&document.session)).await?;
+        if described["node"]["shadowRoots"].as_array().is_some_and(|roots| {
+            roots.iter().any(|root| root["shadowRootType"] == "closed")
+        }) {
+            return Err(FOCUS_CHANGED.to_string());
+        }
+        let resolved = client.send_command("DOM.resolveNode", Some(serde_json::json!({
+            "backendNodeId": backend_id, "executionContextId": document.execution_context_id,
+            "objectGroup": "agent-browser"
+        })), Some(&document.session)).await?;
+        let object = resolved["object"]["objectId"]
+            .as_str()
+            .filter(|object| !object.is_empty())
+            .ok_or(FOCUS_UNAVAILABLE)?;
+        let focused = client.send_command("Runtime.callFunctionOn", Some(serde_json::json!({
+            "objectId": object,
+            "functionDeclaration": r#"function strictRefFocus() {
+                const get = (prototype, name, element) => Object.getOwnPropertyDescriptor(prototype, name).get.call(element);
+                const doc = get(Node.prototype, 'ownerDocument', this);
+                if (!get(Node.prototype, 'isConnected', this) || !Document.prototype.hasFocus.call(doc)) return false;
+                let expected = this;
+                let root = Node.prototype.getRootNode.call(expected);
+                while (root instanceof ShadowRoot) {
+                    if (get(ShadowRoot.prototype, 'activeElement', root) !== expected) return false;
+                    expected = get(ShadowRoot.prototype, 'host', root);
+                    root = Node.prototype.getRootNode.call(expected);
+                }
+                if (root !== doc || get(Document.prototype, 'activeElement', doc) !== expected) return false;
+                // A focusable host may delegate focus to a deeper open-root node.
+                let deep = this;
+                while (deep instanceof Element) {
+                    const shadow = get(Element.prototype, 'shadowRoot', deep);
+                    if (!shadow) break;
+                    const active = get(ShadowRoot.prototype, 'activeElement', shadow);
+                    if (!active) break;
+                    deep = active;
+                }
+                return deep === this;
+            }"#,
+            "returnByValue": true
+        })), Some(&document.session)).await;
+        release_strict_object(client, &document.session, object).await;
+        let focused = focused?;
+        if focused.get("exceptionDetails").is_some() {
+            return Err(FOCUS_UNAVAILABLE.into());
+        }
+        let result = focused
+            .get("result")
+            .ok_or(FOCUS_UNAVAILABLE)?;
+        if result.get("type").and_then(Value::as_str) != Some("boolean") {
+            return Err(FOCUS_UNAVAILABLE.into());
+        }
+        match result.get("value").and_then(Value::as_bool) {
+            Some(true) => {}
+            Some(false) => return Err(FOCUS_CHANGED.into()),
+            None => return Err(FOCUS_UNAVAILABLE.into()),
+        }
+        Ok::<_, String>(())
+    }.await;
+    result.map_err(|error| {
+        if error == FOCUS_CHANGED {
+            error
+        } else {
+            // A CDP/transport failure is not a confirmed native focus rejection.
+            "FOCUS_UNAVAILABLE".to_string()
+        }
+    })
+}
