+            let mut anchor = element(id + 1, "A", vec![]);
+            anchor["attributes"] = json!([
+                "href",
+                format!("/public/jobs/{}/detail?secret=yes#secret", 123 + i)
+            ]);
+            let budget = element(id + 2, "SPAN", vec![]);
+            children.push(element(id, "LI", vec![anchor, budget]));
+            nodes.extend([
+                ax_node(id + 1, "link", &format!("Own title {i}: 5,000円/60分")),
+                ax_node(id + 2, "StaticText", "固定報酬制 50,000円 仮払い確認済み"),
+            ]);
+        }
+        let dom = json!({"root":{"backendNodeId":1,"nodeType":9,"nodeName":"#document","frameId":"main",
+            "documentURL":PAGE,"baseURL":PAGE,"childNodeCount":1,
+            "children":[element(2,"HTML",vec![element(3,"BODY",children)])]}});
+        let ids: Vec<Value> = nodes
+            .iter()
+            .skip(1)
+            .map(|node| node["nodeId"].clone())
+            .collect();
+        nodes[0]["childIds"] = json!(ids);
+        (json!({"nodes":nodes}), dom)
