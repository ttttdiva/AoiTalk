new file mode 100644
index 0000000..be6c7bc
--- /dev/null
+++ b/cli/tests/bridge_helper_cli.rs
@@ -0,0 +1,565 @@
+// AoiTalk Portable Bridge custom modification, 2026-10-10. Based on vercel-labs/agent-browser; see NOTICE-bridge-modifications.txt.
+//! Standalone bridge CLI contracts using an isolated fake CDP WebSocket server.
+//! These tests never launch, download, or contact a real browser.
+use futures_util::{SinkExt, StreamExt};
+use serde_json::{json, Value};
+use std::process::{Command, Output, Stdio};
+use std::time::Duration;
+use tempfile::TempDir;
+use tokio_tungstenite::tungstenite::Message;
+
+const BIN: &str = env!("CARGO_BIN_EXE_agent-browser");
+
+fn cli(tmp: &TempDir) -> Command {
+    let mut command = Command::new(BIN);
+    command.current_dir(tmp.path());
+    for (key, _) in std::env::vars().filter(|(key, _)| key.starts_with("AGENT_BROWSER_")) {
+        command.env_remove(key);
+    }
+    command
+        .env("HOME", tmp.path())
+        .env("USERPROFILE", tmp.path())
+        .env("AGENT_BROWSER_SOCKET_DIR", tmp.path().join("sockets"))
+        .env("NO_COLOR", "1");
+    command
+}
+
+fn payload(output: &Output) -> Value {
+    serde_json::from_slice(&output.stdout)
+        .unwrap_or_else(|error| panic!("{error}: {}", String::from_utf8_lossy(&output.stdout)))
+}
+
+async fn metadata_server(targets: Value) -> (String, tokio::task::JoinHandle<Vec<Value>>) {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let endpoint = format!(
+        "ws://127.0.0.1:{}/devtools/browser/test-browser",
+        listener.local_addr().unwrap().port()
+    );
+    let server = tokio::spawn(async move {
+        let (socket, _) = tokio::time::timeout(Duration::from_secs(10), listener.accept())
+            .await
+            .unwrap()
+            .unwrap();
+        let mut ws = tokio_tungstenite::accept_async(socket).await.unwrap();
+        let mut seen = Vec::new();
+        while let Ok(Some(Ok(message))) =
+            tokio::time::timeout(Duration::from_secs(10), ws.next()).await
+        {
+            let Message::Text(text) = message else {
+                break;
+            };
+            let command: Value = serde_json::from_str(&text).unwrap();
+            let result = match command["method"].as_str().unwrap() {
+                "Browser.getVersion" => {
+                    json!({"product":"Chrome/test","protocolVersion":"1.3","userAgent":"PRIVATE_AGENT"})
+                }
+                "Target.getTargets" => json!({"targetInfos":targets}),
+                other => panic!("Unexpected CDP command: {other}"),
+            };
+            ws.send(Message::Text(
+                json!({"id":command["id"],"result":result}).to_string(),
+            ))
+            .await
+            .unwrap();
+            seen.push(command);
+        }
+        seen
+    });
+    (endpoint, server)
+}
+
