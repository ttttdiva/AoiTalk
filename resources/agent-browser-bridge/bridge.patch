+fn strict_cli_error(flags: &Flags, args: &[String]) -> Option<&'static str> {
+    if !flags.strict_refs {
+        return None;
+    }
+    if flags.debug {
+        return Some("Strict-ref bridge mode does not allow debug output");
+    }
+    let command = args.first().map(String::as_str).unwrap_or("");
+    if command == "mcp" {
+        return Some("Strict MCP startup configuration is not inherited safely; start plain mcp and pass the dedicated strict config or complete strict settings on every tool call");
+    }
+    let sub = args.get(1).map(String::as_str);
+    let allowed = match command {
+        "session" => sub == Some("info"),
+        "stream" => matches!(sub, Some("status" | "disable")),
+        "close" | "quit" | "exit" => !args.iter().any(|arg| arg == "--all"),
+        "open" | "goto" | "navigate" | "connect" | "snapshot" | "click" | "dblclick" | "fill"
+        | "reconnect" | "type" | "hover" | "select" | "check" | "uncheck" | "focus" | "clear"
+        | "selectall" | "scrollintoview" | "scrollinto" | "scroll" | "back" | "forward"
+        | "reload" | "tab" | "verify" | "crowdworks-inspect" => true,
+        _ => false,
+    };
+    if allowed {
+        None
+    } else {
+        Some("Command is not available in strict-ref bridge mode")
+    }
