+    #[tokio::test]
+    async fn strict_restore_and_mutators_are_rejected_before_state_changes() {
+        for action in ["launch", "snapshot", "navigate", "close"] {
+            for (key, value) in [
+                ("restoreKey", json!("CANARY_PRIVATE_RESTORE")),
+                ("restoreSave", json!("always")),
+                ("restoreCheckFn", json!("CANARY_PRIVATE_SCRIPT")),
+                ("plugins", json!([{ "name": "untrusted" }])),
+            ] {
+                let mut state = DaemonState::new();
+                state.strict_refs = true;
+                let before = state.session_name.clone();
+                let mut command =
+                    json!({"id":"strict-restore","action":action,"redactEditableValues":true});
+                command[key] = value;
+                let response = execute_command(&command, &mut state).await;
+                assert_eq!(response["success"], false, "{action} {key}");
+                assert_eq!(response["code"], "STRICT_SESSION_REQUIRED");
+                assert!(!response.to_string().contains("CANARY_PRIVATE"));
