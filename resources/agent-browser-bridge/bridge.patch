+    fn body(dom: &mut Value) -> &mut Vec<Value> {
+        dom["root"]["children"][0]["children"][0]["children"]
+            .as_array_mut()
+            .unwrap()
+    }
+    fn push_body(dom: &mut Value, value: Value) {
+        body(dom).push(value);
+        dom["root"]["children"][0]["children"][0]["childNodeCount"] = json!(body(dom).len());
+    }
