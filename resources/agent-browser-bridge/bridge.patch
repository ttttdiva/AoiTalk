+    fn append_ax(ax: &mut Value, nodes: Vec<Value>) {
+        let all = ax["nodes"].as_array_mut().unwrap();
+        all.extend(nodes);
+        let child_ids: HashSet<String> = all
+            .iter()
+            .filter(|node| node["role"]["value"] != "RootWebArea")
+            .filter_map(|node| node["childIds"].as_array())
+            .flatten()
+            .map(|id| id.as_str().unwrap().to_string())
+            .collect();
+        let ids: Vec<Value> = all
+            .iter()
+            .filter(|node| {
+                node["role"]["value"] != "RootWebArea"
+                    && !child_ids.contains(node["nodeId"].as_str().unwrap())
+            })
+            .map(|node| node["nodeId"].clone())
+            .collect();
+        all.iter_mut()
+            .find(|node| node["role"]["value"] == "RootWebArea")
+            .unwrap()["childIds"] = json!(ids);
+    }
+    fn project_fixture(ax: &Value, dom: &Value) -> Result<Value, &'static str> {
+        project(ax, dom, PAGE, "main", 1)
