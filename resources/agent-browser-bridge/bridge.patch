index 0000000..5f0520c
--- /dev/null
+++ b/cli/src/native/crowdworks.rs
@@ -0,0 +1,1329 @@
+// AoiTalk Portable Bridge custom modification, 2026-10-10. Based on vercel-labs/agent-browser; see NOTICE-bridge-modifications.txt.
+//! Bounded CrowdWorks observation on one already selected strict target.
+//! This is a projection of native CDP data, never an action/ref provider. No
+//! renderer getters, HTML, attributes, raw URLs, AX values or titles are exported.
+use std::collections::{HashMap, HashSet};
+
+use serde_json::{json, Map, Value};
+use url::Url;
+
+use super::cdp::client::CdpClient;
+use super::element::capture_strict_document;
+use super::snapshot::project_editable_values;
+
+pub(super) const UNSUPPORTED: &str = "CROWDWORKS_SCOPE_UNSUPPORTED";
+pub(super) const OVERFLOW: &str = "CROWDWORKS_SCOPE_OVERFLOW";
+pub(super) const UNAVAILABLE: &str = "CROWDWORKS_INSPECTION_UNAVAILABLE";
+const MAX_NODES: usize = 20_000;
+const MAX_DEPTH: usize = 64;
+const MAX_SCAN_BYTES: usize = 4 * 1024 * 1024;
+const MAX_CANDIDATES: usize = 200;
+const MAX_LABEL_BYTES: usize = 4096;
+const MAX_CONTEXT_BYTES: usize = 16_000;
+const MAX_TEXT_BYTES: usize = 128 * 1024;
+const MAX_OUTPUT_BYTES: usize = 512 * 1024;
+const MAX_SERIALIZED_DATA_BYTES: usize = 786_432;
+
+fn unambiguous_url_text(raw: &str) -> Result<(), &'static str> {
+    if raw.trim() != raw || raw.chars().any(char::is_control) || raw.contains('\\') {
+        return Err(UNSUPPORTED);
+    }
+    let authority = if let Some(tail) = raw.strip_prefix("//") {
+        Some(tail)
+    } else if let Some((scheme, tail)) = raw.split_once(':') {
+        if scheme.eq_ignore_ascii_case("https") || scheme.eq_ignore_ascii_case("http") {
+            Some(tail.strip_prefix("//").ok_or(UNSUPPORTED)?)
+        } else {
+            None
+        }
+    } else {
+        None
+    };
+    if authority.is_some_and(|tail| {
+        tail.is_empty()
+            || tail.starts_with('/')
+            || tail
+                .split(['/', '?', '#'])
+                .next()
+                .is_some_and(|part| part.contains('@'))
+    }) {
+        return Err(UNSUPPORTED);
+    }
+    Ok(())
+}
+
+fn scoped_url(raw: &str) -> Result<Url, &'static str> {
+    unambiguous_url_text(raw)?;
+    let url = Url::parse(raw).map_err(|_| UNSUPPORTED)?;
+    if url.scheme() != "https"
+        || !matches!(url.host_str(), Some("crowdworks.jp" | "www.crowdworks.jp"))
+        || !url.username().is_empty()
+        || url.password().is_some()
+        || url.port().is_some_and(|port| port != 443)
+        || !(url.path() == "/public/jobs" || url.path().starts_with("/public/jobs/"))
+    {
+        return Err(UNSUPPORTED);
+    }
+    Ok(url)
+}
+
+fn canonical_job(url: &Url) -> Option<String> {
+    scoped_url(url.as_str()).ok()?;
+    let id = url
+        .path()
+        .strip_prefix("/public/jobs/")?
+        .split('/')
+        .next()?;
+    if id.is_empty() || !id.bytes().all(|byte| byte.is_ascii_digit()) {
+        return None;
+    }
+    Some(format!("https://crowdworks.jp/public/jobs/{id}"))
+}
+
+/// A complete bounded scan precedes editable projection, whose DOM recursion
+/// and name dependency closure must never process unbounded input here.
+fn scan_budget(value: &Value) -> Result<(), &'static str> {
+    let mut stack = vec![(value, 0usize)];
+    let mut bytes = 0usize;
+    let mut entries = 0usize;
+    while let Some((value, depth)) = stack.pop() {
+        entries += 1;
+        if depth > MAX_DEPTH * 3 || entries > MAX_NODES * 64 {
+            return Err(OVERFLOW);
+        }
+        match value {
+            Value::String(text) => bytes = bytes.saturating_add(text.len()),
+            Value::Object(object) => {
+                for (key, child) in object {
+                    bytes = bytes.saturating_add(key.len());
+                    stack.push((child, depth + 1));
+                }
+            }
+            Value::Array(array) => stack.extend(array.iter().map(|v| (v, depth + 1))),
+            _ => bytes = bytes.saturating_add(8),
+        }
+        if bytes > MAX_SCAN_BYTES {
+            return Err(OVERFLOW);
+        }
+    }
+    Ok(())
+}
+
+struct DomNode<'a> {
+    raw: &'a Value,
+    parent: Option<usize>,
+    end: usize,
+    included: bool,
+    scope_boundary: bool,
+}
+
+struct DomIndex<'a> {
+    nodes: Vec<DomNode<'a>>,
+    by_backend: HashMap<i64, usize>,
+}
+
+fn attribute<'a>(node: &'a Value, name: &str) -> Result<Option<&'a str>, &'static str> {
+    let Some(attributes) = node.get("attributes") else {
+        return Ok(None);
+    };
+    let attributes = attributes.as_array().ok_or(UNSUPPORTED)?;
+    if !attributes.len().is_multiple_of(2) {
+        return Err(UNSUPPORTED);
+    }
+    let mut found = None;
+    for pair in attributes.as_chunks::<2>().0 {
+        let key = pair[0].as_str().ok_or(UNSUPPORTED)?;
+        let value = pair[1].as_str().ok_or(UNSUPPORTED)?;
+        if key.eq_ignore_ascii_case(name) {
+            if found.is_some() {
+                return Err(UNSUPPORTED);
+            }
+            found = Some(value);
+        }
+    }
+    Ok(found)
+}
+
+impl<'a> DomIndex<'a> {
+    fn build(root: &'a Value) -> Result<Self, &'static str> {
+        if root["nodeType"] != 9 || root["nodeName"] != "#document" {
+            return Err(UNSUPPORTED);
+        }
+        let mut index = Self {
+            nodes: Vec::new(),
+            by_backend: HashMap::new(),
+        };
+        index.visit(root, None, true, 0)?;
+        Ok(index)
+    }
+
+    fn visit(
+        &mut self,
+        node: &'a Value,
+        parent: Option<usize>,
+        included: bool,
+        depth: usize,
+    ) -> Result<bool, &'static str> {
+        if depth > MAX_DEPTH || self.nodes.len() >= MAX_NODES {
+            return Err(OVERFLOW);
+        }
+        let backend = node["backendNodeId"].as_i64().ok_or(UNSUPPORTED)?;
+        let tag = node["nodeName"].as_str().ok_or(UNSUPPORTED)?;
+        let included = included
+            && !matches!(
+                tag,
+                "IFRAME" | "FRAME" | "TEMPLATE" | "SCRIPT" | "STYLE" | "NOSCRIPT"
+            )
+            && attribute(node, "hidden")?.is_none()
+            && !attribute(node, "aria-hidden")?
+                .is_some_and(|value| value.eq_ignore_ascii_case("true"));
+        let position = self.nodes.len();
+        if self.by_backend.insert(backend, position).is_some() {
+            return Err(UNSUPPORTED);
+        }
+        self.nodes.push(DomNode {
+            raw: node,
+            parent,
+            end: position + 1,
+            included,
+            scope_boundary: !included,
+        });
+        let mut boundary = !included;
+        if let Some(count) = node.get("childNodeCount") {
+            let count = count.as_u64().ok_or(UNSUPPORTED)?;
+            let children = node
+                .get("children")
+                .and_then(Value::as_array)
+                .map_or(0, Vec::len);
+            if included && count != children as u64 {
+                return Err(UNSUPPORTED);
+            }
+        }
+        for key in ["children", "shadowRoots", "pseudoElements"] {
+            if let Some(children) = node.get(key) {
+                for child in children.as_array().ok_or(UNSUPPORTED)? {
+                    boundary |= self.visit(
+                        child,
+                        Some(position),
+                        included && key == "children",
+                        depth + 1,
+                    )?;
+                }
+            }
+        }
+        for key in ["contentDocument", "templateContent", "importedDocument"] {
+            if let Some(child) = node.get(key) {
+                boundary |= self.visit(child, Some(position), false, depth + 1)?;
+            }
+        }
+        self.nodes[position].end = self.nodes.len();
+        self.nodes[position].scope_boundary = boundary;
+        Ok(boundary)
+    }
+
+    fn card(&self, anchor: usize) -> Result<usize, &'static str> {
+        let mut current = Some(anchor);
+        while let Some(i) = current {
+            let node = &self.nodes[i];
+            if node.included
+                && node.raw["nodeType"] == 1
+                && (matches!(node.raw["nodeName"].as_str(), Some("TR" | "LI" | "ARTICLE"))
+                    || matches!(attribute(node.raw, "role")?, Some("row" | "listitem")))
+            {
+                return Ok(i);
+            }
+            current = node.parent;
+        }
+        let parent = self.nodes[anchor].parent.ok_or(UNSUPPORTED)?;
+        if !self.nodes[parent].included || self.nodes[parent].raw["nodeType"] != 1 {
+            return Err(UNSUPPORTED);
+        }
+        Ok(parent)
+    }
+}
+
+/// Require a complete main AX graph before claiming complete text coverage.
+/// Out-of-scope frame branches may be absent, but an in-scope missing child,
+/// inconsistent parent, duplicate ID, cycle or disconnected visible node is not
+/// an empty/complete observation.
+fn validate_ax_graph(
+    nodes: &[Value],
+    dom: &DomIndex<'_>,
+    document: i64,
+) -> Result<(), &'static str> {
+    let mut by_id = HashMap::new();
+    let mut root = None;
+    for node in nodes {
+        let id = node["nodeId"]
+            .as_str()
+            .filter(|id| !id.is_empty())
+            .ok_or(UNSUPPORTED)?;
+        if by_id.insert(id, node).is_some() {
+            return Err(UNSUPPORTED);
+        }
+        if node["role"]["value"] == "RootWebArea"
+            && node["backendDOMNodeId"] == document
+            && root.replace(id).is_some()
+        {
+            return Err(UNSUPPORTED);
+        }
+    }
+    let root = root.ok_or(UNSUPPORTED)?;
+    let in_scope = |node: &Value| {
+        node["backendDOMNodeId"]
+            .as_i64()
+            .and_then(|id| dom.by_backend.get(&id))
+            .is_none_or(|i| dom.nodes[*i].included)
+    };
+    let mut parents = HashMap::new();
+    let mut edges: HashMap<&str, Vec<&str>> = HashMap::new();
+    for (&id, node) in &by_id {
+        if let Some(children) = node.get("childIds") {
+            for child in children.as_array().ok_or(UNSUPPORTED)? {
+                let child = child.as_str().ok_or(UNSUPPORTED)?;
+                if !by_id.contains_key(child) {
+                    if in_scope(node) {
+                        return Err(UNSUPPORTED);
+                    }
+                    continue;
+                }
+                if parents.insert(child, id).is_some() {
+                    return Err(UNSUPPORTED);
+                }
+                edges.entry(id).or_default().push(child);
+            }
+        }
+    }
+    if parents.contains_key(root) {
+        return Err(UNSUPPORTED);
+    }
+    for (&id, node) in &by_id {
+        if let Some(parent) = node.get("parentId") {
+            let parent = parent.as_str().ok_or(UNSUPPORTED)?;
+            if in_scope(node) && parents.get(id).copied() != Some(parent) {
+                return Err(UNSUPPORTED);
+            }
+        }
+    }
+    let mut seen = HashSet::new();
+    let mut stack = vec![(root, 0usize)];
+    while let Some((id, depth)) = stack.pop() {
+        if depth > MAX_DEPTH {
+            return Err(OVERFLOW);
+        }
+        if !seen.insert(id) {
+            return Err(UNSUPPORTED);
+        }
+        if let Some(children) = edges.get(id) {
+            stack.extend(children.iter().map(|child| (*child, depth + 1)));
+        }
+    }
+    if by_id
+        .iter()
+        .any(|(id, node)| in_scope(node) && !seen.contains(id))
+    {
+        return Err(UNSUPPORTED);
+    }
+    Ok(())
+}
+
+fn native_link_url(node: &Value) -> Result<Option<&str>, &'static str> {
+    let mut result = None;
+    if let Some(properties) = node.get("properties") {
+        for property in properties.as_array().ok_or(UNSUPPORTED)? {
+            if property["name"] == "url" {
+                if result.is_some() || property["value"]["type"] != "string" {
+                    return Err(UNSUPPORTED);
+                }
+                result = Some(property["value"]["value"].as_str().ok_or(UNSUPPORTED)?);
+            }
+        }
+    }
+    Ok(result)
+}
+
+fn destination(node: &Value, dom: &Value, base: &Url) -> Result<Url, &'static str> {
+    let native = native_link_url(node)?
+        .map(|raw| {
+            unambiguous_url_text(raw)?;
+            Url::parse(raw).map_err(|_| UNSUPPORTED)
+        })
+        .transpose()?;
+    let fallback = if dom["nodeType"] == 1 && dom["nodeName"] == "A" && dom["localName"] == "a" {
+        attribute(dom, "href")?
+            .map(|href| {
+                unambiguous_url_text(href)?;
+                base.join(href).map_err(|_| UNSUPPORTED)
+            })
+            .transpose()?
+    } else {
+        None
+    };
+    match (native, fallback) {
+        (Some(native), Some(fallback)) if native != fallback => Err(UNSUPPORTED),
+        (Some(native), _) => Ok(native),
+        (None, Some(fallback)) => Ok(fallback),
+        _ => Err(UNSUPPORTED),
+    }
+}
+
+fn append_text(target: &mut String, text: &str, limit: usize) -> Result<(), &'static str> {
+    let separator = usize::from(!target.is_empty());
+    if target
+        .len()
+        .saturating_add(separator)
+        .saturating_add(text.len())
+        > limit
+    {
+        return Err(OVERFLOW);
+    }
+    if separator != 0 {
+        target.push('\n');
+    }
+    target.push_str(text);
+    Ok(())
+}
+
+/// Build directly from projected raw AX nodes, before snapshot build_tree merges
+/// StaticText into ancestors. All relationships/order are proved by the one DOM
+/// capture. An unsupported or overflowing observation never returns partial data.
+fn project(
+    raw_ax: &Value,
+    dom: &Value,
+    page_url: &str,
+    frame: &str,
+    document_backend: i64,
+) -> Result<Value, &'static str> {
+    scan_budget(raw_ax)?;
+    scan_budget(dom)?;
+    let page = scoped_url(page_url)?;
+    let root = &dom["root"];
+    if root["backendNodeId"].as_i64() != Some(document_backend)
+        || root.get("frameId").is_some_and(|id| id != frame)
+        || Url::parse(root["documentURL"].as_str().ok_or(UNSUPPORTED)?).map_err(|_| UNSUPPORTED)?
+            != page
+    {
+        return Err(UNAVAILABLE);
+    }
+    let base_raw = root["baseURL"].as_str().ok_or(UNSUPPORTED)?;
+    unambiguous_url_text(base_raw)?;
+    let base = Url::parse(base_raw).map_err(|_| UNSUPPORTED)?;
+    if !matches!(base.scheme(), "http" | "https")
+        || !base.username().is_empty()
+        || base.password().is_some()
+    {
+        return Err(UNSUPPORTED);
+    }
+    let index = DomIndex::build(root)?;
+    if !index
+        .nodes
+        .iter()
+        .any(|node| node.included && node.raw["nodeName"] == "HTML" && node.parent == Some(0))
+        || !index.nodes.iter().any(|node| {
+            node.included
+                && node.raw["nodeName"] == "BODY"
+                && node
+                    .parent
+                    .is_some_and(|parent| index.nodes[parent].raw["nodeName"] == "HTML")
+        })
+    {
+        return Err(UNSUPPORTED);
+    }
+    let raw_nodes = raw_ax["nodes"].as_array().ok_or(UNSUPPORTED)?;
+    if raw_nodes.len() > MAX_NODES {
+        return Err(OVERFLOW);
+    }
+    if !raw_nodes.iter().any(|node| {
+        node["role"]["value"] == "RootWebArea"
+            && node["ignored"] == false
+            && node["backendDOMNodeId"] == document_backend
+    }) {
+        return Err(UNSUPPORTED);
+    }
+    // A DOM job anchor omitted from AX is not proof of an empty listing.
+    // Explicit ignored/hidden evidence may exclude it; otherwise fail closed.
+    let ax_by_backend: HashMap<i64, &Value> = raw_nodes
+        .iter()
+        .filter_map(|node| node["backendDOMNodeId"].as_i64().map(|id| (id, node)))
+        .collect();
+    for node in &index.nodes {
+        if node.included && node.raw["nodeName"] == "A" && node.raw["localName"] == "a" {
+            if let Some(href) = attribute(node.raw, "href")? {
+                if base
+                    .join(href)
+                    .ok()
+                    .as_ref()
+                    .and_then(canonical_job)
+                    .is_some()
+                {
+                    let ax = ax_by_backend
+                        .get(&node.raw["backendNodeId"].as_i64().ok_or(UNSUPPORTED)?)
+                        .ok_or(UNSUPPORTED)?;
+                    if ax["ignored"] != true && ax["role"]["value"] != "link" {
+                        return Err(UNSUPPORTED);
+                    }
+                }
+            }
+        }
+    }
+    validate_ax_graph(raw_nodes, &index, document_backend)?;
+    let visible_backends: HashSet<i64> = raw_nodes
+        .iter()
+        .filter(|node| node["ignored"] == false)
+        .filter_map(|node| node["backendDOMNodeId"].as_i64())
+        .collect();
+    let mut projected = raw_ax.clone();
+    project_editable_values(&mut projected, dom).map_err(|_| UNSUPPORTED)?;
+    let projected_nodes = projected["nodes"].as_array().ok_or(UNSUPPORTED)?;
+    let mut text_nodes = Vec::new();
+    let mut candidates = Vec::new();
+    let mut seen_ax = HashSet::new();
+    for (raw, node) in raw_nodes.iter().zip(projected_nodes) {
+        if !seen_ax.insert(raw["nodeId"].to_string()) {
+            return Err(UNSUPPORTED);
+        }
+        let role = node["role"]["value"].as_str().ok_or(UNSUPPORTED)?;
+        if node["ignored"].as_bool().ok_or(UNSUPPORTED)?
+            || matches!(role, "InlineTextBox" | "RootWebArea")
+        {
+            continue;
+        }
+        let name = node["name"]["value"].as_str().unwrap_or("");
+        let Some(backend) = node["backendDOMNodeId"].as_i64() else {
+            if !name.is_empty() || role == "link" {
+                return Err(UNSUPPORTED);
+            }
+            continue;
+        };
+        let position = *index.by_backend.get(&backend).ok_or(UNSUPPORTED)?;
+        let dom_node = &index.nodes[position];
+        if !dom_node.included {
+            continue;
+        }
+        if raw.get("frameId").is_some_and(|id| id != frame) {
+            return Err(UNSUPPORTED);
+        }
+        // Names can derive from out-of-scope descendants or related elements.
+        // Do not relabel such a link from an adjacent heading or raw DOM text.
+        let unsafe_scope_name = raw["name"]["sources"].as_array().is_some_and(|sources| {
+            sources
+                .iter()
+                .filter(|source| source["superseded"] != true && source["invalid"] != true)
+                .any(|source| {
+                    (source["type"] == "contents" && dom_node.scope_boundary)
+                        || ["value", "attributeValue", "nativeSourceValue"]
+                            .iter()
+                            .filter_map(|key| source[*key]["relatedNodes"].as_array())
+                            .flatten()
+                            .any(|related| {
+                                related["backendDOMNodeId"]
+                                    .as_i64()
+                                    .and_then(|id| index.by_backend.get(&id))
+                                    .is_none_or(|i| {
+                                        !index.nodes[*i].included
+                                            || index.nodes[*i].scope_boundary
+                                            || index.nodes[*i].raw["backendNodeId"]
+                                                .as_i64()
+                                                .is_none_or(|id| !visible_backends.contains(&id))
+                                    })
+                            })
+                })
+        });
+        let proved_name_source = raw["name"]["sources"].as_array().is_some_and(|sources| {
+            sources.iter().any(|source| {
+                source["superseded"] != true
+                    && source["invalid"] != true
+                    && source["value"]["value"].as_str() == Some(name)
+                    && ((source["type"] == "relatedElement"
+                        && ["value", "attributeValue", "nativeSourceValue"]
+                            .iter()
+                            .any(|key| {
+                                source[*key]["relatedNodes"]
+                                    .as_array()
+                                    .is_some_and(|nodes| !nodes.is_empty())
+                            }))
+                        || (source["type"] == "attribute"
+                            && matches!(
+                                source["attribute"].as_str(),
+                                Some("aria-label" | "title" | "placeholder")
+                            )))
+            })
+        });
+        if !name.is_empty()
+            && (unsafe_scope_name || (dom_node.scope_boundary && !proved_name_source))
+        {
+            return Err(UNSUPPORTED);
+        }
+        if !name.is_empty() {
+            text_nodes.push((position, name));
+        }
+        if role == "link" {
+            let url = destination(raw, dom_node.raw, &base)?;
+            if let Some(href) = canonical_job(&url) {
+                if name.trim().is_empty() {
+                    return Err(UNSUPPORTED);
+                }
+                if name.len() > MAX_LABEL_BYTES || candidates.len() >= MAX_CANDIDATES {
+                    return Err(OVERFLOW);
+                }
+                candidates.push((position, index.card(position)?, href, name));
+            }
+        }
+    }
+    text_nodes.sort_by_key(|(position, _)| *position);
+    candidates.sort_by_key(|(position, ..)| *position);
+    // A nearest semantic ancestor or fallback parent is not necessarily one
+    // job card. Never assign another job's compensation/escrow text to it.
+    for (_, card, href, _) in &candidates {
+        if candidates.iter().any(|(position, _, other_href, _)| {
+            *position >= *card && *position < index.nodes[*card].end && other_href != href
+        }) {
+            return Err(UNSUPPORTED);
+        }
+    }
+    let mut text = String::new();
+    for (_, name) in &text_nodes {
+        append_text(&mut text, name, MAX_TEXT_BYTES)?;
+    }
+    let mut result = Map::new();
+    let mut output_bytes = text.len();
+    for (i, (_, card, href, label)) in candidates.iter().enumerate() {
+        let mut context = String::new();
+        for (position, name) in &text_nodes {
+            if *position >= *card && *position < index.nodes[*card].end {
+                append_text(&mut context, name, MAX_CONTEXT_BYTES)?;
+            }
+        }
+        if context.is_empty() {
+            return Err(UNSUPPORTED);
+        }
+        output_bytes = output_bytes.saturating_add(context.len() + href.len() + label.len());
+        if output_bytes > MAX_OUTPUT_BYTES {
+            return Err(OVERFLOW);
+        }
+        result.insert(
+            format!("cw_{i}"),
+            json!({"href":href,"label":label,"context":context}),
+        );
+    }
+    let output = json!({"origin":page.origin().ascii_serialization(),"candidates":result,"text":text,
+        "coverage":{"complete":true,"frame_scope":"main","shadow_scope":"none",
+        "candidate_count":candidates.len(),"truncated":false,"unscanned":false}});
+    // JSON escaping can multiply UTF-8 wire size even when string budgets pass.
+    // Keep data below the caller's one-MiB private response transport cap.
+    if serde_json::to_vec(&output).map_err(|_| UNSUPPORTED)?.len() > MAX_SERIALIZED_DATA_BYTES {
+        return Err(OVERFLOW);
+    }
+    Ok(output)
+}
+
+/// Reuse the strict document capability solely for identity. Its only evaluated
+/// expression is the existing isolated-world `document` handle. No getters,
+/// functions, per-card calls, target changes or automatic retries are added.
+pub(super) async fn inspect(client: &CdpClient, session: &str) -> Result<Value, String> {
+    let result = async {
+        let before = client
+            .send_command_no_params("Page.getFrameTree", Some(session))
+            .await
+            .map_err(|_| UNAVAILABLE)?;
+        let frame = &before["frameTree"]["frame"];
+        let mut page_url = frame["url"].as_str().ok_or(UNAVAILABLE)?.to_string();
+        if let Some(fragment) = frame.get("urlFragment") {
+            page_url.push_str(fragment.as_str().ok_or(UNAVAILABLE)?);
+        }
+        scoped_url(&page_url)?;
+        let frame_id = frame["id"].as_str().ok_or(UNAVAILABLE)?;
+        let document = capture_strict_document(client, session, session, None, &before)
+            .await
+            .map_err(|_| UNAVAILABLE)?;
+        let ax = client
+            .send_command(
+                "Accessibility.getFullAXTree",
+                Some(json!({"frameId":frame_id})),
+                Some(session),
+            )
+            .await
+            .map_err(|_| UNAVAILABLE)?;
+        let dom = client
+            .send_command(
+                "DOM.getDocument",
+                Some(json!({"depth":-1,"pierce":true})),
+                Some(session),
+            )
+            .await
+            .map_err(|_| UNAVAILABLE)?;
+        let data = project(&ax, &dom, &page_url, frame_id, document.root_backend_id());
+        let after = client
+            .send_command_no_params("Page.getFrameTree", Some(session))
+            .await
+            .map_err(|_| UNAVAILABLE)?;
+        let current = capture_strict_document(client, session, session, None, &after)
+            .await
+            .map_err(|_| UNAVAILABLE)?;
+        if current != document {
+            return Err(UNAVAILABLE);
+        }
+        data
+    }
+    .await;
+    result.map_err(str::to_string)
+}
