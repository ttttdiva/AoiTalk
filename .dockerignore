# ============================================================================
# AoiTalk .dockerignore
# Dockerビルド時に除外するファイル・ディレクトリ
# ============================================================================

# Python
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
*.egg
.eggs/
dist/
build/
*.whl

# Frontend build inputs generated locally. Dockerfile rebuilds these in its
# own stages; copying them into the context can otherwise exceed 20GB.
frontend/node_modules/
frontend/.next/
frontend/test-results/
frontend/playwright-report/
mobile/
desktop/src-tauri/target/
desktop/node_modules/
test-results/
playwright-report/

# Git
.git/
.github/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment & Secrets
.env
.env*
**/.env
**/.env*

# Logs & Cache
logs/
*.log
cache/
*.cache
temp/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# User Data (should be mounted as volumes)
# Only the root-level runtime workspace is mounted as a volume.  Do not use
# an unanchored `workspaces/` pattern here: the sanitized Enterprise source
# deliberately ships src/tools/workspaces/file_tools.py and Docker would
# otherwise omit that import closure from the build context.
/workspaces/
!src/tools/workspaces/
!src/tools/workspaces/**
artifacts/
sample_livedoor_news/
frontend/public/uploads/
data/foam-curation/
**/*.dump
**/*.sql.gz
**/*.sql
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.db-wal
**/*.db-shm
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.pfx
**/*.p12
**/*.jks
*.apk
*.aab

# SSL Certificates
certs/
**/certs/
caddy/*.exe
caddy/*.dll
caddy/*.pdb

# Documentation (not needed at runtime)
docs/
memory-bank/
*.md
!README.md
!README.enterprise.md

# Test files
tests/
test_*.py
*_test.py
conftest.py

# Development files
*.bat
setup.bat
run.bat
*.ps1

# Sample files
sample_*/
*.sample

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Misc
.DS_Store
Thumbs.db
*.bak
*.orig
