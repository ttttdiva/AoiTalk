# Shell scripts must use LF even on Windows
.gitattributes text eol=lf
*.sh text eol=lf

# Windows batch files require CRLF for reliable cmd.exe execution.
*.bat text eol=crlf
*.cmd text eol=crlf

# Generated runtime hashes cover exact bytes; never apply checkout EOL conversion.
resources/seethrough-rig/runtime/** -text

# Portfolio source SHA/size cover exact bytes; preserve the pinned original.
resources/mediaops/sns_portfolio_v6.md -text

# Reviewed helper provenance is hashed as exact generated bytes.
resources/agent-browser-bridge/build-manifest.json -text

# Redacted historical provenance copy (informational); exact bytes are tracked.
resources/agent-browser-bridge/build-manifest.redacted-historical-provenance.json -text

# Source input pins cover canonical LF bytes, including on Windows.
resources/browser-profile-driver/driver.cjs text eol=lf
resources/edge-browser-extension/background.js text eol=lf
resources/edge-browser-extension/content.js text eol=lf
resources/agent-browser-bridge/upstream.json text eol=lf
resources/agent-browser-bridge/resulting-files.json text eol=lf
resources/agent-browser-bridge/contract.json text eol=lf
resources/agent-browser-bridge/NOTICE-bridge-modifications.txt text eol=lf
# A unified patch uses a single-space prefix for empty context lines.
resources/agent-browser-bridge/bridge.patch text eol=lf whitespace=-blank-at-eol

# Third-party supplemental originals include CP1252 and exact archive CRLF bytes.
resources/agent-browser-bridge/licenses/** -text whitespace=cr-at-eol
resources/agent-browser-bridge/licenses/supplemental/** -text whitespace=cr-at-eol
# The pinned AOM patent original ends with a blank line; preserve its bytes.
resources/agent-browser-bridge/licenses/supplemental/rav1e-0.8.1-PATENTS.txt whitespace=cr-at-eol,-blank-at-eof
resources/pc-bridge-distribution/Visual-C-V14-License-Redistributable_and_Runtime_ENU.* -text whitespace=cr-at-eol
# Jev loop and provenance are hash-pinned; preserve canonical generated bytes.
resources/browser-profile-driver/jev-lib.cjs -text
resources/browser-profile-driver/jev-provenance.json text eol=lf
resources/browser-profile-driver/jev-browser.patch text eol=lf whitespace=-blank-at-eol
resources/browser-profile-driver/JEV-THIRD-PARTY-NOTICES.txt -text whitespace=cr-at-eol,-blank-at-eof
resources/browser-profile-driver/README.md text eol=lf
