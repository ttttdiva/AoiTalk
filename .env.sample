# AoiTalk Voice Assistant - Environment Configuration Sample
# Copy this file to .env and configure your API keys and settings

# =============================================================================
# API Keys (使用する機能/Providerに応じて設定)
# =============================================================================

# OpenAI API Key (llm_provider: openai または OpenAI 依存ツールを使う場合)
OPENAI_API_KEY=

# OpenRouter API Key (llm_provider: openrouter を使う場合)
OPENROUTER_API_KEY=
# 通常は変更不要。OpenRouter側のURLやアプリ表示名を明示的に上書きする場合だけ使います。
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_APP_NAME=AoiTalk
# OPENROUTER_SITE_URL=https://your-site.example
# OPENROUTER_HTTP_REFERER=https://your-site.example

# Moonshot AI公式 Kimi API (llm_provider: kimi を使う場合)
MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# DeepSeek公式API (llm_provider: deepseek を使う場合)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepInfra公式API (llm_provider: deepinfra を使う場合)
DEEPINFRA_TOKEN=
# DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# Discord Bot Token (Discord Bot 使用時のみ)
DISCORD_BOT_TOKEN=

# Gemini API Key
GEMINI_API_KEY=

# xAI Grok (X検索) API Key
XAI_API_KEY=
# XAI_GROK_MODEL=grok-4-0709
# XAI_API_BASE=https://api.x.ai/v1

# X投稿の直接取得（任意）。公開syndication/oEmbedを先に試し、必要な場合だけ使用します。
# X_BEARER_TOKEN=
# Netscape cookie形式のruntime secretを運用者が明示した場合だけ、ユーザー個人設定が
# ない利用者向けの共有サーバー互換フォールバックとして認証付きHTML取得を試します。
# 個人Cookieは /api/users/me/x-cookie からユーザー単位で暗号化保存します。
# リポジトリ外の個人用ツールやcookie保管場所を自動探索・コピーしません。
# AOITALK_X_COOKIE_FILE=.runtime-secrets/x.cookies.txt

# Nijivoice API Key (にじボイス使用時)
NIJIVOICE_API_KEY=

# OpenWeatherMap API Key (天気情報取得用、オプション)
# https://openweathermap.org/api から無料で取得可能
OPENWEATHER_API_KEY=


# ── TTS エンジンパス ────────────────────────────────────────
# 標準検出で足りない場合のみ設定します。
# VOICEVOX_ENGINE_PATH=$HOME/voicevox_core/linux-nvidia/run
# VOICEROID_ENGINE_PATH="%PROGRAMFILES%\AHS\VOICEROID2\VoiceroidEditor.exe"
# COEIROINK_ENGINE_PATH="D:\tool\COEIROINK_WIN_GPU_v.2.1.1\COEIROINKv2.exe"
# AIVOICE_ENGINE_PATH="%PROGRAMFILES%\AI\AIVoice\AIVoiceEditor\AIVoiceEditor.exe"
# CEVIO_ENGINE_PATH="%PROGRAMFILES%\CeVIO\CeVIO AI\CeVIO AI.exe"
# AIVISSPEECH_ENGINE_PATH="%LOCALAPPDATA%\Programs\AivisSpeech\AivisSpeech-Engine\run.exe"

# フォールバック用パス
# VOICEVOX_ENGINE_FALLBACK_PATH="%LOCALAPPDATA%\Programs\VOICEVOX\vv-engine\run.exe"
# VOICEROID_ENGINE_FALLBACK_PATH=
# COEIROINK_ENGINE_FALLBACK_PATH=
# AIVOICE_ENGINE_FALLBACK_PATH=
# CEVIO_ENGINE_FALLBACK_PATH=
# AIVISSPEECH_ENGINE_FALLBACK_PATH="%LOCALAPPDATA%\Programs\AivisSpeech\AivisSpeech-Engine\run.exe"

# VOICEVOX host and port (標準値から変える場合のみ)
# VOICEVOX_HOST=127.0.0.1
# VOICEVOX_PORT=50021

# AivisSpeech host and port (標準値から変える場合のみ)
# AIVISSPEECH_HOST=127.0.0.1
# AIVISSPEECH_PORT=10101

# Audio Player ディレクトリ (音楽ファイルの格納先)
# AUDIO_PLAYER_DIR=

# WSL PulseAudio Runtime Path (WSL 環境でのみ必要)
# PULSE_RUNTIME_PATH=/mnt/wslg/runtime-dir/pulse

# ── Spotify API 設定 ───────────────────────────────────────
# https://developer.spotify.com/dashboard でアプリを作成
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# 標準値から変える場合のみ。標準: http://127.0.0.1:8080/callback
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# ── PostgreSQL 設定 ───────────────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aoitalk_memory
POSTGRES_USER=aoitalk
POSTGRES_PASSWORD=

# メモリ管理 (PostgreSQL + pgvector を使用する場合は true に)
USE_POSTGRESQL=true

# Drizzle CLI など、単一URLが必要な場合のみ使用します。
# 通常のWebUIは POSTGRES_* から接続URLを組み立てます。
# DATABASE_URL=postgres://aoitalk:<POSTGRES_PASSWORD>@127.0.0.1:5432/aoitalk_memory

# SQLite 用ライブラリパスの調整 (必要に応じて)
# LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu

# ── デバッグ設定 ────────────────────────────────────────
# Discord Bot音声受信のデバッグモード（debug_audioディレクトリに音声ファイルを保存）
# AOITALK_DEBUG=true

# ── WebUI / API 認証設定 ─────────────────────────────────
# ログインアカウントはDBの users テーブルで管理します。
# ここにユーザー名/パスワードは置きません。
NEXTAUTH_SECRET=
AOITALK_WEB_AUTH_SECRET=
AOITALK_JWT_SECRET=
AOITALK_APP_BRIDGE_SECRET=
INTERNAL_API_KEY=
# Web Push (optional): set all three values to enable background OS reminders.
# Keep the VAPID private key on the server only. Without these values AoiTalk
# keeps in-app/Discord reminders and task operations continue normally.
# AOITALK_WEB_PUSH_VAPID_PRIVATE_KEY=
# AOITALK_WEB_PUSH_VAPID_PUBLIC_KEY=
# AOITALK_WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
# AOITALK_WEB_PUSH_LATE_TTL_SECONDS=900
# Scheduler look-ahead (minutes). Keep this at least as large as the maximum
# task/user reminder offset; the default covers one week without tab activity.
# AOITALK_TASK_NOTIFICATION_LOOKAHEAD_MINUTES=10080
# Content deletion audit/tombstone retention in days. Invalid, non-positive,
# or extreme values fail safe to 30 days (maximum accepted value: 3650).
AOITALK_DELETION_RETENTION_DAYS=30
AOITALK_CADDY_GATE_KEY=
AOITALK_BOOTSTRAP_ADMIN_USERNAME=admin
AOITALK_BOOTSTRAP_ADMIN_PASSWORD=
# DB内の機密フィールド用鍵。Linux/Enterpriseの本番では会社の
# secret-manager helperをイメージへ含めるかread-only volumeで渡し、
# base64の32 byte鍵だけをstdoutへ返すコマンドを設定する（鍵そのものは.envへ置かない）。
# AOITALK_FIELD_CRYPTO_KEY_COMMAND=/usr/local/bin/aoitalk-field-key
# AOITALK_FIELD_CRYPTO_ALLOW_LOCAL_KEY_FILE=false
# AOITALK_FIELD_CRYPTO_LOCAL_KEY_FILE=/app/cache/field-crypto.key
# WSL等の隔離検証だけ、上記コマンドの代わりにtrueで永続ローカル鍵を許可する。
# AOITALK_FIELD_CRYPTO_ALLOW_LOCAL_KEY_FILE=true
# AOITALK_FIELD_CRYPTO_ALLOW_ENV_KEY=false
# AOITALK_FIELD_CRYPTO_KEY_B64=
# Enterprise/Dockerではtrue。main AoiTalkの開発時は未設定で構いません。
AOITALK_PROFILE=
AOITALK_REQUIRE_DATABASE=false
AOITALK_REQUIRE_AUTH_SECRET=false
# DBなしの未認証互換モードは明示的な隔離開発時だけ有効化します。
# AOITALK_ALLOW_UNAUTHENTICATED_DEV=true
# Linux native既定はloopback。公開時はCaddyをTLS境界として明示する。
AOITALK_WEB_HOST=127.0.0.1
AOITALK_NEXT_HOST=127.0.0.1
AOITALK_FRONTEND_HOST=127.0.0.1
# Linux nativeではrun.shがtrueを設定する。Windowsのrun.batではCaddyを起動する。
AOITALK_SKIP_CADDY=false
AOITALK_WEB_AUTO_OPEN=false
# Docker Compose/Caddyで公開する場合。public/bootstrapそれぞれのHTTPS外部ポートとCaddy内部ポートは同じ値にする。
# AOITALK_CADDY_SITE_ADDRESS=localhost
# AOITALK_PUBLIC_BIND_ADDRESS=0.0.0.0
# AOITALK_HTTP_PORT=80
# AOITALK_HTTPS_PORT=443
# AOITALK_CADDY_PORT=443
# AOITALK_BOOTSTRAP_HTTPS_PORT=8443
# AOITALK_BOOTSTRAP_CADDY_PORT=8443
# AOITALK_CADDY_HEALTH_HOST=127.0.0.1
# AOITALK_CADDYFILE_PATH=./caddy/Caddyfile.enterprise
# AOITALK_CADDY_CERTS_DIR=./caddy/certs
# AOITALK_CADDY_TLS_DIRECTIVE=tls /etc/caddy/certs/server.crt /etc/caddy/certs/server.key
# SGLang/Gemma 4 E4B。既定値は検証済みdigestで固定しています。
# SGLANG_IMAGE=lmsysorg/sglang@sha256:7b6a35df9839fd593a94a1eaee82d7777f472225d9f3ad1f8a2e0cb2bd1785d0
# QDRANT_IMAGE=qdrant/qdrant@sha256:94728574965d17c6485dd361aa3c0818b325b9016dac5ea6afec7b4b2700865f
# SGLANG_MODEL=google/gemma-4-E4B-it
# private/gated modelを取得する場合だけHF_TOKENを設定する。公開モデルは空でよい。
# HF_TOKEN=
# 既に認証済みの Hugging Face cache を使う場合は、ホスト側で標準 env
# (HF_HOME / HF_HUB_CACHE 等) を設定してください。AoiTalk は独自 cache root を
# 作らず、設定済み env があれば Compose 経由で pass-through します。
# 標準ポート以外で動かす場合のみ。標準: http://127.0.0.1:3000
# PYTHON_API_URL=http://127.0.0.1:3000
# NEXTAUTH_URL=http://127.0.0.1:3002

# ── HuggingFace バックアップ設定 ────────────────────────────
# https://huggingface.co でリポジトリを作成
HUGGINGFACE_REPO_ID=
# WebファイラーのHFタブ用。画面の「参照追加」から自動更新されます。
HF_ACCOUNTS=
HF_REFERENCE_REPOS=[]
# 公開リポジトリ参照で任意利用する共通token。個別tokenは HF_TOKEN_<username> 形式です。
HUGGINGFACE_API_KEY=

# Optional external crawler status integrations
DISCORD_CRAWLER_PATH=
EVENT_MONITOR_PATH=
VIDEO_CRAWLER_URL=
VIDEO_CRAWLER_RUNTIME_URL=
VIDEO_CRAWLER_SPACE_URL=

# Optional local model launchers.
# Empty values use defaults under the checkout drive's AI directory.
LLAMA_SERVER_EXE=
# Generic llama.cpp/llama-server runtime (existing openai_compatible_local provider).
# Windows resolves llama-server.exe and Linux resolves llama-server from PATH when
# LLAMA_CPP_EXECUTABLE is empty.  No GGUF is downloaded automatically.
LLAMA_CPP_EXECUTABLE=
LLAMA_CPP_MODEL_PATH=
# Optional GGUF discovery root (for example D:\\AI\\models\\Hot\\llm).
# Exact profile filenames are required; AoiTalk does not download models.
LLAMA_CPP_MODEL_ROOT=
# Muse Glimmer convenience override (same value as LLAMA_CPP_MODEL_PATH).
MUSE_GLIMMER_MODEL_PATH=
# 空なら選択中 profile の served_alias / default_context_size を使う。operator が意図的に override する時だけ値を入れる。
LLAMA_CPP_MODEL_ALIAS=
LLAMA_CPP_HOST=127.0.0.1
LLAMA_CPP_PORT=8080
LLAMA_CPP_CONTEXT_SIZE=
LLAMA_CPP_GPU_LAYERS=999
LLAMA_CPP_EXTRA_ARGS=
LLAMA_CPP_AUTO_START=true
LLAMA_CPP_READINESS_TIMEOUT=180
# macOS OpenAI-compatible local servers. Leave empty to use PATH/module defaults.
# exo default API: http://127.0.0.1:52415/v1
# MLX LM default API: http://127.0.0.1:8080/v1
EXO_COMMAND=
EXO_ROOT=
MLX_LM_COMMAND=
# llama-server --ctx-size と AoiTalk のcontext予算を明示的に合わせる場合のみ設定します。
# 未設定時はサーバーmetadataから自動検出し、検出不能時は保守的な既定値を使います。
# OPENAI_COMPATIBLE_LOCAL_CONTEXT_WINDOW_TOKENS=8192

# ── OS操作ツール設定 ─────────────────────────────────────
# コマンド実行・ファイル編集を許可するディレクトリ（カンマ区切り）
# 未設定の場合は制限なし
# AOITALK_ALLOWED_PATHS=C:\Projects,D:\Data
# コマンドタイムアウト（秒）。標準値から変える場合のみ。
# AOITALK_COMMAND_TIMEOUT=120

# ── ドキュメント（メモ帳）設定 ─────────────────────────────────
# ドキュメント保存ディレクトリ（デフォルト: ./documents）
# AOITALK_DOCUMENTS_DIR=./documents

# ── SGLang / ローカルLLM設定 ─────────────────────────────────────
# SGLang等のOpenAI互換APIを持つローカルLLMサーバーを使用する場合
# llm_provider: sglang を設定し、以下の環境変数を設定してください
# SGLANG_BASE_URL=http://127.0.0.1:30000/v1
# SGLANG_MODEL=google/gemma-4-E4B-it
# SGLANG_API_KEY=dummy
# SGLANG_REASONING_PARSER=gemma4
# SGLANG_TOOL_CALL_PARSER=gemma4
# Fresh Gemma 4 weights can take 15+ minutes to become ready. These values
# allow strict Enterprise startup to wait for a cold GPU host.
# SGLANG_HEALTHCHECK_START_PERIOD=600s
# SGLANG_HEALTHCHECK_RETRIES=180

# Ollama OpenAI-compatible local API
# llm_provider: ollama を設定し、標準値から変える場合のみ使います。
# 標準: OLLAMA_BASE_URL=http://127.0.0.1:11434/v1 / OLLAMA_API_KEY=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma4:e4b
# OLLAMA_API_KEY=ollama
# OllamaでAoiTalkのツール呼び出しを試す場合のみ config の ollama.enable_tools を true にしてください。

# ── Caddy TLS ─────────────────────────────────────────────────
# Caddyは既定で自動HTTPS（内部CAまたは公開CA）を使用します。
# 会社CAの証明書を固定利用する場合は、deployment-specific Caddyfileで
# `tls /path/to/cert.crt /path/to/cert.key` を設定してください。
# 証明書・秘密鍵はリポジトリへ置かず、ホスト側の秘密ボリュームから渡します。

# ── ファイラー 絶対パス閲覧設定 ─────────────────────────────────
# ファイラーでローカルの画像・動画・音声ファイルの絶対パスを開く場合だけ設定します。
# FILER_ROOT_PATH=D:\f\a
# 標準値から変える場合のみ。標準: cache/video_thumbnails
# FILER_VIDEO_THUMBNAIL_CACHE=cache/video_thumbnails

# ── RAG (Qdrant + BGE) 設定 ─────────────────────────────────────
# Qdrantベクトルデータベースへの接続設定 (標準値から変える場合のみ)
# Docker: docker run -p 6333:6333 -p 6334:6334 qdrant/qdrant
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_API_KEY=  # Qdrant Cloud使用時

# ── Docker環境設定 ────────────────────────────────────────────────
# docker-compose使用時はこれらの値はdocker-compose.ymlで自動設定されます
# 以下はDocker環境での動作を制御するための設定です

# Docker環境検出フラグ (docker-compose.ymlで自動設定)
# AOITALK_DOCKER=true

# Headlessモード (Docker内で音声出力を無効化)
# Docker環境では自動的にtrueになります
# AOITALK_HEADLESS=true

# ホスト設定 (docker-compose使用時は自動設定)
# POSTGRES_HOST=postgres
# QDRANT_HOST=qdrant
# VOICEVOX_HOST=voicevox
# AIVISSPEECH_HOST=aivisspeech

# Google Calendar OAuth
# Register this callback URL in Google Cloud OAuth client settings.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:3000/api/google-calendar/oauth/callback
# Optional override for signed OAuth state.
# GOOGLE_CALENDAR_STATE_SECRET=

# Webex Messaging OAuth（読み取り専用）
# https://developer.webex.com/my-apps で Integration を作成し、
# spark:rooms_read / spark:messages_read / spark:people_read を許可します。
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=
WEBEX_REDIRECT_URI=http://127.0.0.1:3000/api/webex/oauth/callback
# Optional override for signed OAuth state. 未設定時は INTERNAL_API_KEY または Client Secret を使用します。
# WEBEX_STATE_SECRET=

# Agent harness optional overrides. The harness stays disabled unless enabled in config/config.yaml.
# AOITALK_AGENT_HARNESS_WORKSPACE_ROOT=cache/agent_workspaces
# Scoped Memory v2 rollout. Legacy Agent Memory Docs are read-only by default.
SCOPED_MEMORY_V2_ENABLED=true
LEGACY_AGENT_MEMORY_READ_ENABLED=true
LEGACY_AGENT_MEMORY_WRITE_ENABLED=false
