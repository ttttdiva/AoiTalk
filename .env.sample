# AoiTalk Voice Assistant - Environment Configuration Sample
# Copy this file to .env and configure your API keys and settings

# =============================================================================
# API Keys (使用する機能/Providerに応じて設定)
# =============================================================================

# OpenAI API Key (llm_provider: openai または OpenAI 依存ツールを使う場合)
OPENAI_API_KEY=

# OpenRouter API Key (llm_provider: openrouter を使う場合)
OPENROUTER_API_KEY=
# 通常は変更不要。OpenRouter側のURLやアプリ表示名を明示的に上書きする場合だけ使います。
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_APP_NAME=AoiTalk
# OPENROUTER_SITE_URL=https://your-site.example
# OPENROUTER_HTTP_REFERER=https://your-site.example

# Moonshot AI公式 Kimi API (llm_provider: kimi を使う場合)
MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Discord Bot Token (Discord Bot 使用時のみ)
DISCORD_BOT_TOKEN=

# Gemini API Key
GEMINI_API_KEY=

# xAI Grok (X検索) API Key
XAI_API_KEY=
# XAI_GROK_MODEL=grok-4-0709
# XAI_API_BASE=https://api.x.ai/v1

# Nijivoice API Key (にじボイス使用時)
NIJIVOICE_API_KEY=

# OpenWeatherMap API Key (天気情報取得用、オプション)
# https://openweathermap.org/api から無料で取得可能
OPENWEATHER_API_KEY=


# ── TTS エンジンパス ────────────────────────────────────────
# 標準検出で足りない場合のみ設定します。
# VOICEVOX_ENGINE_PATH=$HOME/voicevox_core/linux-nvidia/run
# VOICEROID_ENGINE_PATH="%PROGRAMFILES%\AHS\VOICEROID2\VoiceroidEditor.exe"
# COEIROINK_ENGINE_PATH="D:\tool\COEIROINK_WIN_GPU_v.2.1.1\COEIROINKv2.exe"
# AIVOICE_ENGINE_PATH="%PROGRAMFILES%\AI\AIVoice\AIVoiceEditor\AIVoiceEditor.exe"
# CEVIO_ENGINE_PATH="%PROGRAMFILES%\CeVIO\CeVIO AI\CeVIO AI.exe"
# AIVISSPEECH_ENGINE_PATH="%LOCALAPPDATA%\Programs\AivisSpeech\AivisSpeech-Engine\run.exe"

# フォールバック用パス
# VOICEVOX_ENGINE_FALLBACK_PATH="%LOCALAPPDATA%\Programs\VOICEVOX\vv-engine\run.exe"
# VOICEROID_ENGINE_FALLBACK_PATH=
# COEIROINK_ENGINE_FALLBACK_PATH=
# AIVOICE_ENGINE_FALLBACK_PATH=
# CEVIO_ENGINE_FALLBACK_PATH=
# AIVISSPEECH_ENGINE_FALLBACK_PATH="%LOCALAPPDATA%\Programs\AivisSpeech\AivisSpeech-Engine\run.exe"

# VOICEVOX host and port (標準値から変える場合のみ)
# VOICEVOX_HOST=127.0.0.1
# VOICEVOX_PORT=50021

# AivisSpeech host and port (標準値から変える場合のみ)
# AIVISSPEECH_HOST=127.0.0.1
# AIVISSPEECH_PORT=10101

# Audio Player ディレクトリ (音楽ファイルの格納先)
# AUDIO_PLAYER_DIR=

# WSL PulseAudio Runtime Path (WSL 環境でのみ必要)
# PULSE_RUNTIME_PATH=/mnt/wslg/runtime-dir/pulse

# ── Spotify API 設定 ───────────────────────────────────────
# https://developer.spotify.com/dashboard でアプリを作成
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# 標準値から変える場合のみ。標準: http://127.0.0.1:8080/callback
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# ── PostgreSQL 設定 ───────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aoitalk_memory
POSTGRES_USER=aoitalk
POSTGRES_PASSWORD=aoitalk_password

# メモリ管理 (PostgreSQL + pgvector を使用する場合は true に)
USE_POSTGRESQL=true

# Drizzle CLI など、単一URLが必要な場合のみ使用します。
# 通常のWebUIは POSTGRES_* から接続URLを組み立てます。
# DATABASE_URL=postgres://aoitalk:aoitalk_password@127.0.0.1:5432/aoitalk_memory

# SQLite 用ライブラリパスの調整 (必要に応じて)
# LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu

# ── デバッグ設定 ────────────────────────────────────────
# Discord Bot音声受信のデバッグモード（debug_audioディレクトリに音声ファイルを保存）
# AOITALK_DEBUG=true

# ── WebUI / API 認証設定 ─────────────────────────────────
# ログインアカウントはDBの users テーブルで管理します。
# ここにユーザー名/パスワードは置きません。
NEXTAUTH_SECRET=
AOITALK_WEB_AUTH_SECRET=
AOITALK_JWT_SECRET=
INTERNAL_API_KEY=
# 標準ポート以外で動かす場合のみ。標準: http://127.0.0.1:3000
# PYTHON_API_URL=http://127.0.0.1:3000
# NEXTAUTH_URL=http://127.0.0.1:3002

# ── HuggingFace バックアップ設定 ────────────────────────────
# https://huggingface.co でリポジトリを作成
HUGGINGFACE_REPO_ID=
# WebファイラーのHFタブ用。画面の「参照追加」から自動更新されます。
HF_ACCOUNTS=
HF_REFERENCE_REPOS=[]
# 公開リポジトリ参照で任意利用する共通token。個別tokenは HF_TOKEN_<username> 形式です。
HUGGINGFACE_API_KEY=

# Optional external crawler status integrations
DISCORD_CRAWLER_PATH=
EVENT_MONITOR_PATH=
VIDEO_CRAWLER_URL=
VIDEO_CRAWLER_RUNTIME_URL=
VIDEO_CRAWLER_SPACE_URL=

# Optional local model launchers.
# Empty values use defaults under the checkout drive's AI directory.
LUCE_DFLASH_ROOT=
LUCE_DFLASH_TARGET_MODEL=
LUCE_DFLASH_DRAFT_MODEL=
QWOPUS_MODEL_PATH=
LLAMA_SERVER_EXE=
# macOS OpenAI-compatible local servers. Leave empty to use PATH/module defaults.
# exo default API: http://127.0.0.1:52415/v1
# MLX LM default API: http://127.0.0.1:8080/v1
EXO_COMMAND=
EXO_ROOT=
MLX_LM_COMMAND=
# llama-server --ctx-size と AoiTalk のcontext予算を明示的に合わせる場合のみ設定します。
# 未設定時はサーバーmetadataから自動検出し、検出不能時は保守的な既定値を使います。
# OPENAI_COMPATIBLE_LOCAL_CONTEXT_WINDOW_TOKENS=8192

# ── OS操作ツール設定 ─────────────────────────────────────
# コマンド実行・ファイル編集を許可するディレクトリ（カンマ区切り）
# 未設定の場合は制限なし
# AOITALK_ALLOWED_PATHS=C:\Projects,D:\Data
# コマンドタイムアウト（秒）。標準値から変える場合のみ。
# AOITALK_COMMAND_TIMEOUT=120

# ── ドキュメント（メモ帳）設定 ─────────────────────────────────
# ドキュメント保存ディレクトリ（デフォルト: ./documents）
# AOITALK_DOCUMENTS_DIR=./documents

# ── SGLang / ローカルLLM設定 ─────────────────────────────────────
# SGLang等のOpenAI互換APIを持つローカルLLMサーバーを使用する場合
# llm_provider: sglang を設定し、以下の環境変数を設定してください
# SGLANG_BASE_URL=http://localhost:30000/v1
# SGLANG_MODEL=meta-llama/Llama-3.1-8B-Instruct
# SGLANG_API_KEY=dummy

# Ollama OpenAI-compatible local API
# llm_provider: ollama を設定し、標準値から変える場合のみ使います。
# 標準: OLLAMA_BASE_URL=http://127.0.0.1:11434/v1 / OLLAMA_API_KEY=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma4:e4b
# OLLAMA_API_KEY=ollama
# OllamaでAoiTalkのツール呼び出しを試す場合のみ config の ollama.enable_tools を true にしてください。

# ── Caddy TLS 証明書パス ────────────────────────────────────────
# caddy/Caddyfile の {$AOITALK_CERT_CRT:default} / {$AOITALK_CERT_KEY:default} に展開される。
# 未設定の場合は Caddyfile 側の default パスにフォールバックするので、
# デフォルトと異なる場所に証明書を置く場合のみ以下を有効化する。絶対パス推奨。
# AOITALK_CERT_CRT=/path/to/certs/your-host.crt
# AOITALK_CERT_KEY=/path/to/certs/your-host.key

# ── ファイラー 絶対パス閲覧設定 ─────────────────────────────────
# ファイラーでローカルの画像・動画・音声ファイルの絶対パスを開く場合だけ設定します。
# FILER_ROOT_PATH=D:\f\a
# 標準値から変える場合のみ。標準: cache/video_thumbnails
# FILER_VIDEO_THUMBNAIL_CACHE=cache/video_thumbnails

# ── RAG (Qdrant + BGE) 設定 ─────────────────────────────────────
# Qdrantベクトルデータベースへの接続設定 (標準値から変える場合のみ)
# Docker: docker run -p 6333:6333 -p 6334:6334 qdrant/qdrant
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_API_KEY=  # Qdrant Cloud使用時

# ── Docker環境設定 ────────────────────────────────────────────────
# docker-compose使用時はこれらの値はdocker-compose.ymlで自動設定されます
# 以下はDocker環境での動作を制御するための設定です

# Docker環境検出フラグ (docker-compose.ymlで自動設定)
# AOITALK_DOCKER=true

# Headlessモード (Docker内で音声出力を無効化)
# Docker環境では自動的にtrueになります
# AOITALK_HEADLESS=true

# ホスト設定 (docker-compose使用時は自動設定)
# POSTGRES_HOST=postgres
# QDRANT_HOST=qdrant
# VOICEVOX_HOST=voicevox
# AIVISSPEECH_HOST=aivisspeech

# Google Calendar OAuth
# Register this callback URL in Google Cloud OAuth client settings.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:3000/api/google-calendar/oauth/callback
# Optional override for signed OAuth state.
# GOOGLE_CALENDAR_STATE_SECRET=

# Agent harness optional overrides. The harness stays disabled unless enabled in config/config.yaml.
# AOITALK_AGENT_HARNESS_WORKSPACE_ROOT=cache/agent_workspaces
