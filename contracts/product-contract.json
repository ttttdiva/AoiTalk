  "capabilities": [
    {
      "id": "auth.login",
      "domain": "auth",
      "criticality": "p0",
      "transport": "fastapi",
      "operations": [
        {
          "operation_id": "login_mobile_api_auth_login_mobile_post",
          "transport": "fastapi",
          "method": "POST",
          "role": "command"
        }
      ],
      "mobile": {
        "routes": [
          "auth.login"
        ],
        "entry_points": [
          "auth"
        ],
        "implementation": "mobile/src/contexts/AuthContext.tsx"
      },
      "roles": [
        "anonymous"
      ],
      "permissions": [
        "public"
      ],
      "scope": {
        "kind": "public",
        "visibility": "public"
      },
      "offline": {
        "read": "forbidden",
        "mutation": "forbidden",
        "reconnect": "none"
      },
      "persistence": "none",
      "mutation": "direct_online",
      "acceptance": [
        {
          "id": "auth.login",
          "given": "the user has valid credentials",
          "when": "the login form is submitted",
          "then": "the session is stored and the authenticated shell is reachable"
        }
      ]
    },
    {
      "id": "auth.scope",
      "domain": "auth",
      "criticality": "p0",
      "transport": "fastapi",
      "operations": [
        {
          "operation_id": "auth_status_api_auth_status_get",
          "transport": "fastapi",
          "method": "GET",
          "role": "read"
        }
      ],
      "mobile": {
        "routes": [
          "tabs.chat",
          "tabs.settings"
        ],
        "entry_points": [
          "tab.chat",
          "settings"
        ],
        "implementation": "mobile/src/contexts/AuthContext.tsx"
      },
      "roles": [
        "user",
        "admin"
      ],
      "permissions": [
        "read"
      ],
      "scope": {
        "kind": "auth_user",
        "visibility": "auth_user"
      },
      "offline": {
        "read": "cache",
        "mutation": "forbidden",
        "reconnect": "refresh"
      },
      "persistence": "sqlite_cache",
      "mutation": "none",
      "acceptance": [
        {
          "id": "auth.scope",
          "given": "a cached session exists",
          "when": "the app resumes or switches account",
          "then": "server auth status is revalidated before scoped data is shown"
        }
      ]
    },
