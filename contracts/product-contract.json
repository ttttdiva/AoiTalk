        "user",
        "admin"
      ],
      "permissions": [
        "read"
      ],
      "scope": {
        "kind": "auth_user",
        "visibility": "auth_user"
      },
      "offline": {
        "read": "cache",
        "mutation": "local",
        "reconnect": "none"
      },
      "persistence": "none",
      "mutation": "local_only",
      "acceptance": [
        {
          "id": "navigation.shell",
          "given": "the authenticated shell is loaded",
          "when": "the user opens the app offline",
          "then": "the canonical five tabs remain stable and Apps is not a bottom tab"
        }
      ]
    },
    {
      "id": "navigation.apps_entry",
      "domain": "navigation",
      "criticality": "p0",
      "transport": "local",
