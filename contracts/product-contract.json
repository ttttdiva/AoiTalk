      "offline": {
        "read": "cache",
        "mutation": "forbidden",
        "reconnect": "refresh"
      },
      "persistence": "sqlite_cache",
      "mutation": "none",
      "acceptance": [
        {
          "id": "chat.search",
          "given": "the user has readable conversations in multiple projects",
          "when": "a non-empty query is submitted",
          "then": "only readable sessions/messages are returned and the search header remains intact"
        }
