      "domain": "navigation",
      "criticality": "p0",
      "transport": "local",
      "operations": [],
      "mobile": {
        "routes": [
          "root",
          "tabs.chat",
          "tabs.tasks",
          "tabs.calendar",
          "tabs.filer",
          "tabs.docs"
