      "offline": {
        "read": "cache",
        "mutation": "local",
        "reconnect": "none"
      },
      "persistence": "sqlite_cache",
      "mutation": "local_only",
      "acceptance": [
        {
          "id": "navigation.apps",
          "given": "Apps is hidden from the bottom tab bar",
