      },
      "offline": {
        "read": "cache",
        "mutation": "queue",
        "reconnect": "replay_outbox"
      },
      "persistence": "sqlite_and_outbox",
      "mutation": "outbox_replay",
      "acceptance": [
        {
          "id": "chat.sessions",
          "given": "a conversation is cached locally",
          "when": "the user sends a message offline and reconnects",
