# Copy this file to .env.  deploy-compose.sh never stores generated secrets in
# this file; they live in AOITALK_SECRETS_DIR with mode 0600.

# AOITALK_IMAGE is generated by deploy-compose.sh after the local BuildKit
# build.  It is a local tag plus AOITALK_IMAGE_ID=sha256:<64hex>; it is never
# treated as a mutable registry reference.
AOITALK_IMAGE=
AOITALK_IMAGE_ID=
# Dependency values are generated/verified from bundle-manifest.json.  Do not
# replace them with tags or a different repository.
AOITALK_POSTGRES_IMAGE=pgvector/pgvector@sha256:a36250871de0833b8757561c72f2477ef1ddd1101afa4e617fb552e0de514c6b
AOITALK_QDRANT_IMAGE=qdrant/qdrant@sha256:94728574965d17c6485dd361aa3c0818b325b9016dac5ea6afec7b4b2700865f
AOITALK_CADDY_IMAGE=caddy@sha256:834468128c7696cec0ceea6172f7d692daf645ae51983ca76e39da54a97c570d
AOITALK_BUSYBOX_IMAGE=busybox@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662
AOITALK_CURL_IMAGE=curlimages/curl@sha256:d9b4541e214bcd85196d6e92e2753ac6d0ea699f0af5741f8c6cccbfcf00ef4b
# Optional NVIDIA-only generic CUDA backend.  This is never the company
# default and is intentionally separate from the AMD Gemma/vLLM backend.
AOITALK_SGLANG_IMAGE=lmsysorg/sglang@sha256:16aba8925507e631e1dc1e23d95d026533602591775f6a8db68b74ee99746155
AOITALK_GEMMA_VLLM_IMAGE=rocm/vllm@sha256:394194d36edcf9b36bcb563e143b21b80e64e7d04f33a447b448c0c0c00c04a8
AOITALK_DEEPSEEK_LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp@sha256:5a7d34c5a378b6f3b542e71690bd82db7b5bf31fd77d9d1582cc7f2c9043ad8c

# Release files live under /opt/aoitalk. Persistent application data is kept
# under /var/lib/aoitalk and is not Docker's own layer store.
AOITALK_DATA_ROOT=/var/lib/aoitalk
AOITALK_SECRETS_DIR=/etc/aoitalk/secrets
AOITALK_RUNTIME_CONFIG_FILE=/etc/aoitalk/runtime-config/enterprise.yaml
AOITALK_HTTPS_PORT=6002
AOITALK_HTTP_PORT=6001
AOITALK_BOOTSTRAP_HTTPS_PORT=8443
AOITALK_PUBLIC_BIND_ADDRESS=0.0.0.0
AOITALK_PUBLIC_HOST=localhost
AOITALK_CADDY_TLS_DIRECTIVE=tls internal
AOITALK_CADDY_CERTS_DIR=/var/lib/aoitalk/caddy/certs

# Backend and transport are independent.  The Enterprise standard is an
# operator-owned llama.cpp router on the Linux host.  The legacy
# AOITALK_LLM_MODE variable is accepted as an alias by the launcher, and the
# in-container gemma-vllm/deepseek/sglang profiles remain available as
# explicitly selected compatibility backends.
AOITALK_BACKEND=external
AOITALK_TRANSPORT=https
AOITALK_LLM_MODE=external
AOITALK_ALLOWED_PROVIDER_IDS=openai_compatible_local
AOITALK_EXTERNAL_PROVIDER=openai_compatible_local
AOITALK_EXTERNAL_MODEL=qwen3.8-27b
AOITALK_EXTERNAL_BASE_URL=http://host.docker.internal:18080/v1
AOITALK_EXTERNAL_REQUIRED_MODELS=qwen3.8-27b,gemma-4-26b-a4b-it-qat-q4-0
SGLANG_MODEL=google/gemma-4-E4B-it

# Official Gemma/vLLM model contract. The target downloads the pinned model
# from the handoff manifest and runtime remains offline.
AOITALK_GEMMA_MODEL=google/gemma-4-E4B-it
AOITALK_GEMMA_SERVED_MODEL=google/gemma-4-E4B-it
AOITALK_GEMMA_MODEL_REVISION=ee0ef6023621cff504d758262d4e04895a5af4a2
AOITALK_GEMMA_MODEL_FILE=model.safetensors
AOITALK_GEMMA_MODEL_SIZE_BYTES=15992595884
AOITALK_GEMMA_MODEL_SHA256=
AOITALK_GEMMA_MODEL_DIR=/var/lib/aoitalk/huggingface/gemma-4E4B-it
AOITALK_GEMMA_VLLM_BASE_URL=http://gemma-vllm:8000/v1
AOITALK_GEMMA_VLLM_SERVER_PROFILE=vllm
AOITALK_GEMMA_VLLM_PORT=8000
AOITALK_GEMMA_VLLM_CONTEXT_LENGTH=32768
AOITALK_GEMMA_VLLM_DTYPE=bfloat16
AOITALK_GEMMA_VLLM_MEM_UTIL=0.80

# Experimental DeepSeek llama.cpp is intentionally conservative and never
# auto-downloads or claims production performance.
AOITALK_DEEPSEEK_MODEL_DIR=/var/lib/aoitalk/huggingface/deepseek-llamacpp
AOITALK_DEEPSEEK_MODEL_FILE=model.gguf
AOITALK_DEEPSEEK_SERVED_MODEL=deepseek-llamacpp
AOITALK_DEEPSEEK_BASE_URL=http://deepseek-llamacpp:8080/v1

# Optional egress proxy for external LLM calls. Docker image loading and
# Compose startup do not use these values.
AOITALK_HTTP_PROXY=
AOITALK_HTTPS_PROXY=
AOITALK_NO_PROXY=localhost,127.0.0.1,postgres,qdrant,aoitalk,host.docker.internal,gemma-vllm,deepseek-llamacpp,sglang
AOITALK_QDRANT_HEALTHCHECK_RETRIES=120
AOITALK_QDRANT_HEALTHCHECK_START_PERIOD=600s
AOITALK_POSTGRES_HEALTHCHECK_RETRIES=120
AOITALK_POSTGRES_HEALTHCHECK_START_PERIOD=600s
AOITALK_CADDY_HEALTHCHECK_RETRIES=60
AOITALK_CADDY_HEALTHCHECK_START_PERIOD=300s

# Production should point this at a KMS/keyring helper. The local file
# fallback is explicit so a fresh isolated host can boot without a keyring.
AOITALK_FIELD_CRYPTO_KEY_COMMAND=
AOITALK_FIELD_CRYPTO_ALLOW_ENV_KEY=false
AOITALK_FIELD_CRYPTO_ALLOW_LOCAL_KEY_FILE=false
AOITALK_FIELD_CRYPTO_LOCAL_KEY_FILE=/app/cache/field-crypto.key
