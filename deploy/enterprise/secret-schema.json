{
  "schema_version": 1,
  "description": "Canonical Enterprise secret boundary. The env value is materialized only by the root entrypoint and the matching *_FILE is removed before gosu.",
  "max_bytes": 8192,
  "secrets": [
    {"env": "POSTGRES_PASSWORD", "file": "postgres_password", "required": true, "kind": "database", "services": ["postgres", "aoitalk"]},
    {"env": "NEXTAUTH_SECRET", "file": "nextauth_secret", "required": true, "kind": "auth", "services": ["aoitalk"]},
    {"env": "AOITALK_WEB_AUTH_SECRET", "file": "web_auth_secret", "required": true, "kind": "auth", "services": ["aoitalk"]},
    {"env": "AOITALK_JWT_SECRET", "file": "jwt_secret", "required": true, "kind": "auth", "services": ["aoitalk"]},
    {"env": "AOITALK_APP_BRIDGE_SECRET", "file": "app_bridge_secret", "required": true, "kind": "auth", "services": ["aoitalk"]},
    {"env": "AUTH_SECRET", "file": "auth_secret", "required": false, "kind": "auth", "services": ["aoitalk"]},
    {"env": "INTERNAL_API_KEY", "file": "internal_api_key", "required": true, "kind": "auth", "services": ["aoitalk"]},
    {"env": "AOITALK_CADDY_GATE_KEY", "file": "caddy_gate_key", "required": true, "kind": "auth", "services": ["aoitalk", "caddy"]},
    {"env": "AOITALK_BOOTSTRAP_ADMIN_PASSWORD", "file": "bootstrap_admin_password", "required": true, "kind": "auth", "services": ["aoitalk"]},
    {"env": "AOITALK_FIELD_CRYPTO_KEY_B64", "file": "field_crypto_key_b64", "required": false, "kind": "auth", "services": ["aoitalk"]},
    {"env": "OPENAI_API_KEY", "file": "openai_api_key", "required": false, "kind": "provider", "provider": "openai", "services": ["aoitalk"]},
    {"env": "OPENROUTER_API_KEY", "file": "openrouter_api_key", "required": false, "kind": "provider", "provider": "openrouter", "services": ["aoitalk"]},
    {"env": "MOONSHOT_API_KEY", "file": "moonshot_api_key", "required": false, "kind": "provider", "provider": "kimi", "services": ["aoitalk"]},
    {"env": "GEMINI_API_KEY", "file": "gemini_api_key", "required": false, "kind": "provider", "provider": "gemini", "services": ["aoitalk"]},
    {"env": "GOOGLE_API_KEY", "file": "google_api_key", "required": false, "kind": "provider", "provider": "gemini", "services": ["aoitalk"]},
    {"env": "XAI_API_KEY", "file": "xai_api_key", "required": false, "kind": "provider", "provider": "xai", "services": ["aoitalk"]},
    {"env": "ANTHROPIC_API_KEY", "file": "anthropic_api_key", "required": false, "kind": "provider", "provider": "anthropic", "services": ["aoitalk"]},
    {"env": "DEEPSEEK_API_KEY", "file": "deepseek_api_key", "required": false, "kind": "provider", "provider": "deepseek", "services": ["aoitalk"]},
    {"env": "DEEPINFRA_TOKEN", "file": "deepinfra_token", "required": false, "kind": "provider", "provider": "deepinfra", "services": ["aoitalk"]},
    {"env": "OPENAI_COMPATIBLE_LOCAL_API_KEY", "file": "openai_compatible_local_api_key", "required": false, "kind": "provider", "provider": "openai_compatible_local", "services": ["aoitalk"]},
    {"env": "OLLAMA_API_KEY", "file": "ollama_api_key", "required": false, "kind": "provider", "provider": "ollama", "services": ["aoitalk"]},
    {"env": "SGLANG_API_KEY", "file": "sglang_api_key", "required": false, "kind": "provider", "provider": "sglang", "services": ["aoitalk", "sglang"]},
    {"env": "NIJIVOICE_API_KEY", "file": "nijivoice_api_key", "required": false, "kind": "integration", "provider": "nijivoice", "services": ["aoitalk"]},
    {"env": "OPENWEATHER_API_KEY", "file": "openweather_api_key", "required": false, "kind": "integration", "provider": "openweather", "services": ["aoitalk"]},
    {"env": "WEBEX_CLIENT_SECRET", "file": "webex_client_secret", "required": false, "kind": "integration", "provider": "webex", "services": ["aoitalk"]},
    {"env": "WEBEX_STATE_SECRET", "file": "webex_state_secret", "required": false, "kind": "integration", "provider": "webex", "services": ["aoitalk"]},
    {"env": "DISCORD_BOT_TOKEN", "file": "discord_bot_token", "required": false, "kind": "integration", "provider": "discord", "services": ["aoitalk"]},
    {"env": "HF_TOKEN", "file": "hf_token", "required": false, "kind": "inference", "provider": "huggingface", "services": ["aoitalk", "sglang"]},
    {"env": "HUGGING_FACE_HUB_TOKEN", "file": "hugging_face_hub_token", "required": false, "kind": "inference", "provider": "huggingface", "services": ["aoitalk", "sglang"]},
    {"env": "HUGGINGFACE_API_KEY", "file": "huggingface_api_key", "required": false, "kind": "inference", "provider": "huggingface", "services": ["aoitalk"]},
    {"env": "OPENAI_FREE_TEAM_API_KEY", "file": "openai_free_team_api_key", "required": false, "kind": "provider", "provider": "openai_free_team", "services": ["aoitalk"]},
    {"env": "GEMINI_FREE_API_KEY", "file": "gemini_free_api_key", "required": false, "kind": "provider", "provider": "gemini_free_team", "services": ["aoitalk"]},
    {"env": "OPENROUTER_FREE_TEAM_API_KEY", "file": "openrouter_free_team_api_key", "required": false, "kind": "provider", "provider": "openrouter_free_team", "services": ["aoitalk"]},
    {"env": "GEMINI_PROMO_API_KEY", "file": "gemini_promo_api_key", "required": false, "kind": "provider", "provider": "gemini_promo", "services": ["aoitalk"]}
  ],
  "providers": {
    "openai": {"env": "OPENAI_API_KEY"},
    "openrouter": {"env": "OPENROUTER_API_KEY"},
    "kimi": {"env": "MOONSHOT_API_KEY"},
    "gemini": {"env": "GEMINI_API_KEY", "aliases": ["GOOGLE_API_KEY"]},
    "xai": {"env": "XAI_API_KEY"},
    "anthropic": {"env": "ANTHROPIC_API_KEY"},
    "deepseek": {"env": "DEEPSEEK_API_KEY"},
    "deepinfra": {"env": "DEEPINFRA_TOKEN"},
    "openai_compatible_local": {"env": "OPENAI_COMPATIBLE_LOCAL_API_KEY"},
    "ollama": {"env": "OLLAMA_API_KEY"},
    "sglang": {"env": "SGLANG_API_KEY"},
    "huggingface": {"env": "HF_TOKEN", "aliases": ["HUGGING_FACE_HUB_TOKEN", "HUGGINGFACE_API_KEY"]},
    "nijivoice": {"env": "NIJIVOICE_API_KEY"},
    "openweather": {"env": "OPENWEATHER_API_KEY"},
    "webex": {"env": "WEBEX_CLIENT_SECRET", "state_env": "WEBEX_STATE_SECRET"},
    "discord": {"env": "DISCORD_BOT_TOKEN"},
    "openai_free_team": {"env": "OPENAI_FREE_TEAM_API_KEY"},
    "gemini_free_team": {"env": "GEMINI_FREE_API_KEY"},
    "openrouter_free_team": {"env": "OPENROUTER_FREE_TEAM_API_KEY"},
    "gemini_promo": {"env": "GEMINI_PROMO_API_KEY"}
  }
}
