# AoiTalk API identity. Use the same bootstrap admin identity that already exists
# in AoiTalk; no bypass identity is created by this plugin.
AOITALK_BOOTSTRAP_ADMIN_USERNAME=
AOITALK_BOOTSTRAP_ADMIN_PASSWORD=

# Optional path to the 41 checkout's .env. If set, only the two bootstrap
# identity keys above are read from that file. This is not the plugin config
# selector; launcher -EnvFile selects the complete plugin config. For direct
# console/module entry, set AOITALK_PLUGIN_CONFIG_FILE or leave it unset to use
# this package's .env.
HOME_MCP_AOITALK_ENV_FILE=

# Existing API setting names stay compatible. Plain HTTP is accepted only for
# loopback. The default is http://127.0.0.1:3000.
HOME_MCP_AOITALK_URL=http://127.0.0.1:3000
HOME_MCP_AOITALK_TARGET_NODE_ID=

# Fill this only after a separate AoiTalk tunnel has been issued for this plugin.
# Do not copy it to the 80_HomeMCPGateway checkout or its home runtime config.
HOME_MCP_AOITALK_TUNNEL_ID=
HOME_MCP_AOITALK_RUNTIME_API_KEY=

# Install the official OpenAI tunnel-client v0.0.14 Windows AMD64 release and
# point to tunnel-client.exe. Alternatively place it at .tools/tunnel-client.exe
# or make tunnel-client available on PATH.
TUNNEL_CLIENT_PATH=
AOITALK_PLUGIN_TUNNEL_CLIENT_VERSION=0.0.14

# This private loopback port is dedicated to this plugin runtime. Change it only
# if another local service already owns it; the launcher checks before binding.
AOITALK_PLUGIN_HEALTH_LISTEN_ADDR=127.0.0.1:8783
